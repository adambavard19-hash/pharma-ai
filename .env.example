# ---------------------------------------------------------------------------
# Pharma.ai — exemple de configuration
# Copier ce fichier en `.env` puis renseigner les valeurs.
# NE JAMAIS committer de secret réel.
# ---------------------------------------------------------------------------

# --- Base de données -------------------------------------------------------
# PostgreSQL 15+. En production : hébergement conforme (HDS si données de santé).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharma_ai?schema=public"
# Optionnel : base « shadow » utilisée par prisma migrate dev.
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharma_ai_shadow?schema=public"

# --- Application -----------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Sécurité --------------------------------------------------------------
# Clé de signature des sessions. Générer avec : openssl rand -base64 48
AUTH_SESSION_SECRET="remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum"
# Clé de chiffrement applicatif des champs sensibles (données de santé).
# Générer avec : openssl rand -base64 32   (32 octets => AES-256-GCM)
DATA_ENCRYPTION_KEY="remplacer-par-une-cle-base64-de-32-octets"

# --- Mode démonstration ----------------------------------------------------
# `true` active le jeu de données fictif et le bandeau « MODE DÉMONSTRATION ».
DEMO_MODE="true"

# --- Fournisseurs IA / OCR -------------------------------------------------
# Valeurs possibles : "mock" (défaut, aucune API externe) | "anthropic" | "openai"
AI_PROVIDER="mock"
OCR_PROVIDER="mock"

# --- Lecture réelle d'une ordonnance photographiée -------------------------
# ⚠️ Une ordonnance photographiée est une DONNÉE DE SANTÉ. L'activer envoie
# l'image à un fournisseur tiers. Trois conditions, délibérément distinctes,
# doivent être réunies — choisir un fournisseur ne suffit pas à trancher où
# part l'image, sous quel contrat de sous-traitance et vers quel hébergement.
#
#   1. OCR_PROVIDER="anthropic"
#   2. ANTHROPIC_API_KEY renseignée
#   3. OCR_SEND_IMAGES_EXTERNALLY="true"  ← l'autorisation explicite
#
# Tant que les trois ne sont pas réunies, l'extraction reste simulée et
# l'application dit précisément ce qui manque. Voir docs/EXTRACTION.md.
OCR_SEND_IMAGES_EXTERNALLY="false"
# OCR_MODEL="claude-opus-5"
# Référentiel médicamenteux : "local-demo" (jeu fictif) | "bdpm" | "custom"
DRUG_KNOWLEDGE_PROVIDER="local-demo"

# Pré-confirmation des lignes intégralement lues.
#
# À "true", une ligne dont CHAQUE champ renseigné a été lu au-dessus du seuil
# de relecture est retenue pour l'analyse sans que le pharmacien la coche, et
# l'écran de vente s'ouvre directement complet. Un seul champ illisible, une
# seule lecture incertaine, une seule valeur non mesurée : la ligne repart en
# vérification manuelle.
#
# Ce que cela ne change pas : la validation de l'ordonnance reste un geste
# explicite, horodaté et signé. Une ligne pré-confirmée n'a été relue par
# personne, et l'écran le dit.
#
# "false" ramène la confirmation ligne par ligne, sans migration.
PRECONFIRM_READ_LINES="true"

# Clés API — laisser vide tant que le fournisseur n'est pas activé.
# Ces clés restent strictement côté serveur.
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# --- Stockage de fichiers --------------------------------------------------
# "local" (dossier ./storage, développement uniquement) | "s3"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Communications --------------------------------------------------------
# « none » est un choix valide : la fiche se remet alors par impression ou QR
# code. Tant qu'aucun fournisseur n'est configuré, l'application journalise
# l'envoi comme SIMULÉ et ne prétend jamais qu'un message a été transmis.
#
# Ne mettez JAMAIS de clé réelle dans ce fichier d'exemple : il est suivi par
# Git. Les valeurs réelles vont dans .env, qui ne l'est pas.
EMAIL_PROVIDER="none"
SMS_PROVIDER="none"

# Expéditeur, obligatoire dès qu'un fournisseur est choisi.
# Le domaine doit être vérifié chez le fournisseur, sinon l'envoi est refusé.
# EMAIL_FROM="Pharmacie Saint-Michel <contact@pharmacie-exemple.fr>"

# --- Option 1 : Resend (HTTPS, aucune dépendance) ---
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""

# --- Option 2 : SMTP (serveur de votre fournisseur ou de votre groupement) ---
# EMAIL_PROVIDER="smtp"
# SMTP_HOST="smtp.exemple.fr"
# SMTP_PORT="587"          # 587 = STARTTLS (recommandé) · 465 = TLS implicite
# SMTP_SECURE="false"      # "true" uniquement pour le port 465
# SMTP_USER="contact@pharmacie-exemple.fr"
# SMTP_PASSWORD=""

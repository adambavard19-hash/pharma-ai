# ---------------------------------------------------------------------------
# Pharma.ai — exemple de configuration
# Copier ce fichier en `.env` puis renseigner les valeurs.
# NE JAMAIS committer de secret réel.
# ---------------------------------------------------------------------------

# --- Base de données -------------------------------------------------------
# PostgreSQL 15+. En production : hébergement conforme (HDS si données de santé).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharma_ai?schema=public"
# Optionnel : base « shadow » utilisée par prisma migrate dev.
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharma_ai_shadow?schema=public"

# --- Application -----------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Sécurité --------------------------------------------------------------
# Clé de signature des sessions. Générer avec : openssl rand -base64 48
AUTH_SESSION_SECRET="remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum"
# Clé de chiffrement applicatif des champs sensibles (données de santé).
# Générer avec : openssl rand -base64 32   (32 octets => AES-256-GCM)
DATA_ENCRYPTION_KEY="remplacer-par-une-cle-base64-de-32-octets"

# --- Mode démonstration ----------------------------------------------------
# `true` active le jeu de données fictif et le bandeau « MODE DÉMONSTRATION ».
DEMO_MODE="true"

# --- Fournisseurs IA / OCR -------------------------------------------------
# Valeurs possibles : "mock" (défaut, aucune API externe) | "anthropic" | "openai"
AI_PROVIDER="mock"
OCR_PROVIDER="mock"
# Référentiel médicamenteux : "local-demo" (jeu fictif) | "bdpm" | "custom"
DRUG_KNOWLEDGE_PROVIDER="local-demo"

# Clés API — laisser vide tant que le fournisseur n'est pas activé.
# Ces clés restent strictement côté serveur.
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# --- Stockage de fichiers --------------------------------------------------
# "local" (dossier ./storage, développement uniquement) | "s3"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Communications (non connectées dans le MVP) ---------------------------
# Tant qu'aucun fournisseur n'est configuré, l'application journalise l'envoi
# comme SIMULÉ et ne prétend jamais qu'un message a réellement été transmis.
EMAIL_PROVIDER="none"
SMS_PROVIDER="none"
# EMAIL_FROM="contact@exemple.fr"
# RESEND_API_KEY=""

{
  "appId": "app.pharmaboost.mobile",
  "appName": "PharmaBoost",
  "webDir": "www",
  "server": {
    "url": "https://pharmaboost.app/m",
    "allowNavigation": ["pharmaboost.app", "*.pharmaboost.app"],
    "errorPath": "hors-ligne.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#f6fafa",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 900, "backgroundColor": "#f6fafa", "showSpinner": false, "launchAutoHide": true },
    "StatusBar": { "style": "LIGHT", "backgroundColor": "#f6fafa", "overlaysWebView": true }
  }
}

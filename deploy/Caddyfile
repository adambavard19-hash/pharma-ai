# HTTPS automatique. Caddy obtient et renouvelle le certificat de
# pharmaboost.app tout seul, dès que le DNS pointe vers ce serveur.
pharmaboost.app, www.pharmaboost.app {
	encode zstd gzip
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

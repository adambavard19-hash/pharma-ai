// ---------------------------------------------------------------------------
// Pharma.ai — modèle de données
//
// Principes structurants :
//  1. MULTI-TENANT STRICT : toute table métier porte `pharmacyId`. L'isolation
//     est en plus imposée au niveau applicatif (src/server/db/tenant.ts).
//  2. SÉPARATION MÉDICAL / COMMERCIAL : les données de santé du patient vivent
//     dans une table dédiée (`PatientHealthProfile`, champs chiffrés) distincte
//     des données commerciales (`Sale`, `Recommendation`).
//  3. AUDITABILITÉ : chaque analyse conserve sa trace (`AnalysisRun.traceJson`),
//     chaque décision son auteur, chaque évènement son horodatage.
//  4. ÉVOLUTIVITÉ : `Organization` permet dès aujourd'hui un groupement
//     d'officines ; `Plan`/`Subscription` préparent la facturation SaaS.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// ORGANISATION & TENANCY
// ===========================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  siren     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacies   Pharmacy[]
  users        User[]
  subscription Subscription?
  aiUsage      AiUsageRecord[]

  @@map("organizations")
}

model Pharmacy {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  slug           String  @unique
  /// Code de parrainage de l'officine (« PB-XXXXXX ») : un filleul qui s'abonne avec ce code réduit son abonnement.
  referralCode   String? @unique
  /// L'officine qui l'a parrainée, s'il y en a une.
  referredById   String?
  /// Numéro FINESS de l'officine (identifiant national).
  finessNumber   String?
  siret          String?
  /// Numéro d'inscription à l'Ordre national des pharmaciens.
  orderNumber    String?

  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  country      String  @default("FR")

  logoUrl    String?
  brandColor String  @default("#0F766E")
  timezone   String  @default("Europe/Paris")

  /// Paramètres officinaux (voir src/config/pharmacy-settings.ts pour le schéma Zod).
  settings Json @default("{}")

  /// Nombre de jours minimum entre deux suivis adressés au même patient.
  /// Appliqué côté serveur, jamais seulement à l'écran : l'objectif n'est pas
  /// de spammer le patient.
  followUpMinIntervalDays Int @default(30)

  /// Dates courtes : une date de péremption à moins de N jours est « bientôt »,
  /// à moins de M jours « urgente ». Réglables par l'officine.
  shortDateSoonDays   Int @default(90)
  shortDateUrgentDays Int @default(30)

  /// Officine du groupe pilote PharmaBoost Partenaires : elle voit les
  /// marques et gammes en statut TEST avant leur diffusion.
  partnerPilot Boolean @default(false)

  /// L'e-mail du plan propose au patient de s'abonner aux nouveautés de
  /// l'officine (un lien : rien n'est conservé tant que le patient ne l'ouvre
  /// pas). Réglable par le titulaire.
  patientNewsEnabled Boolean @default(true)

  /// Ce que CE filleul apporte à son parrain chaque mois, en centimes, figé à
  /// son inscription (offre de parrainage en cours à ce moment-là). Vide : la
  /// règle standard (src/core/billing/referral.ts).
  referralAmountCents Int?

  /// Marque le jeu de données de démonstration. Jamais vrai en production réelle.
  isDemo   Boolean @default(false)
  isActive Boolean @default(true)

  /// Le parcours d'accueil du titulaire (informations, stock, équipe) est
  /// terminé. Tant que c'est vide, l'application le propose à l'ouverture.
  /// Nombre de postes de comptoir déclarés : base du futur calcul de l'abonnement. Historique dans pharmacy_post_count_changes.
  postCount Int?

  onboardingCompletedAt DateTime?
  /// Dernière synchronisation du stock qui a abouti (import de fichier, ou
  /// plus tard un connecteur). Vide : le stock n'a jamais été importé.
  stockSyncedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships         Membership[]
  patients            Patient[]
  reminders           Reminder[]
  products            Product[]
  stockItems          StockItem[]
  stockMovements      StockMovement[]
  drugStocks          PharmacyDrugStock[]
  prescriptions       Prescription[]
  analysisRuns        AnalysisRun[]
  recommendations     Recommendation[]
  pharmacyRules       PharmacyRule[]
  documents           PatientDocument[]
  sales               Sale[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  sessions            Session[]
  imports             ImportJob[]
  stockDeposits       StockDeposit[]
  aiUsage             AiUsageRecord[]
  /// Le dossier commercial dont cette officine est issue, s'il y en a un.
  prospect            Prospect?
  /// La liaison avec le logiciel de gestion de l'officine, s'il y en a une.
  stockConnection     StockConnection?
  /// Les postes de caisse qui écoutent la douchette pour cette officine.
  counterPosts        CounterPost[]
  /// Les codes-barres appris au comptoir.
  productBarcodes     ProductBarcode[]
  /// Contrats et liens d'activation rattachés directement à l'officine.
  contracts           Contract[]
  subscriptionInvites SubscriptionInvite[]

  preferredRanges   PreferredRange[]
  labChallenges     LabChallenge[]
  stockLots         StockLot[]
  productVigilances ProductVigilance[]
  trainingContents  TrainingContent[]

  partnerAudiences         PartnerBrandAudience[]
  partnerPreferences       PharmacyPartnerPreference[]
  partnerAttributions      PartnerAttribution[]
  partnerLeads             PartnerLead[]
  partnerOrders            PartnerOrder[]
  counterRequests          CounterRequest[]
  sealedDocuments          SealedDocument[]
  referredBy               Pharmacy?                   @relation("PharmacyReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                Pharmacy[]                  @relation("PharmacyReferral")
  postCountChanges         PharmacyPostCountChange[]
  adminNotes               AdminNote[]
  cancellationRequests     CancellationRequest[]
  patientNewsSubscriptions PatientNewsSubscription[]
  patientNewsAnnouncements PatientNewsAnnouncement[]

  @@index([organizationId])
  @@map("pharmacies")
}

/// La liaison entre une officine et son logiciel de gestion (LGO), assurée par
/// l'agent PharmaBoost Connect installé sur le serveur de l'officine.
///
/// Un code d'appairage à usage unique relie l'agent à UNE officine ; il
/// obtient alors une clé, dont seule l'empreinte est conservée. Toute
/// synchronisation est datée : le comptoir sait toujours de quand date le
/// stock qu'il affiche, et cesse d'affirmer « en stock » quand c'est trop vieux.
model StockConnection {
  id         String @id @default(cuid())
  pharmacyId String @unique
  /// Identifiant du LGO (src/core/stock/connectors.ts) : lgpi, smart-rx…
  lgo        String
  /// PENDING (code émis, agent pas encore appairé), CONNECTED, STALE, ERROR, DISCONNECTED.
  status     String @default("PENDING")

  pairingCodeHash  String?   @unique
  pairingExpiresAt DateTime?
  agentKeyHash     String?   @unique
  agentVersion     String?
  hostname         String?

  /// Réglages transmis à l'agent : chemin de l'export, dossier des scans, intervalle.
  exportPath      String?
  scansPath       String?
  intervalSeconds Int     @default(300)

  lastSeenAt    DateTime?
  lastSyncAt    DateTime?
  lastSyncLines Int?
  lastError     String?
  pairedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@map("stock_connections")
}

// ===========================================================================
// ABONNEMENT SaaS (modèle économique — facturation branchable ultérieurement)
// ===========================================================================

/// Un code-barres appris au comptoir : la boîte porte le code du fabricant
/// (EAN), l'export du LGO ne donne que le code ACL. La première fois, le
/// pharmacien rattache le code au produit ; ensuite PharmaBoost le reconnaît.
model ProductBarcode {
  id         String   @id @default(cuid())
  pharmacyId String
  productId  String
  code       String
  /// LEARNED (rattaché au comptoir) · IMPORT (venu d'un export)
  source     String   @default("LEARNED")
  createdAt  DateTime @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, code])
  @@index([productId])
  @@map("product_barcodes")
}

/// Un poste de caisse de l'officine sur lequel l'agent écoute la douchette.
///
/// Chaque poste a sa propre clé (seule l'empreinte est conservée), obtenue
/// avec un code d'appairage à usage unique — le même mécanisme que la liaison
/// serveur. Un poste ne lit que les codes-barres tapés par la douchette :
/// rien d'autre ne quitte le poste.
model CounterPost {
  id               String    @id @default(cuid())
  pharmacyId       String
  /// Nom de la machine (« POSTE11 »), tel que Windows le donne.
  hostname         String
  /// Libellé choisi dans PharmaBoost (« Caisse 1 »). Vide : le nom de machine.
  label            String?
  keyHash          String?   @unique
  /// Code d'appairage à usage unique, le temps que le poste se présente.
  pairingCodeHash  String?   @unique
  pairingExpiresAt DateTime?
  pairedAt         DateTime?
  version          String?
  lastSeenAt       DateTime?
  lastScanAt       DateTime?
  scanCount        Int       @default(0)
  /// Dossier, visible depuis ce poste, où le LGO enregistre son édition de
  /// stock (un partage du serveur, par exemple). Vide : ce poste n'envoie
  /// pas de stock.
  exportPath       String?
  /// « Mettre à jour maintenant » : le poste relit l'export dès qu'il voit
  /// cette date changer.
  syncRequestedAt  DateTime?
  lastExportAt     DateTime?
  lastExportError  String?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
  @@map("counter_posts")
}

/// Une offre PharmaBoost, pilotée depuis la console : nom, prix mensuel,
/// durée d'essai. Le prix Stripe correspondant est créé par la console au
/// moment où l'offre est enregistrée — jamais à la main dans Stripe.
///
/// Un prix Stripe est immuable : changer le tarif d'une offre crée un nouveau
/// prix (`stripePriceId` remplacé) ; les abonnements en cours gardent l'ancien.
model Plan {
  id                  String   @id @default(cuid())
  /// Clé stable, en majuscules (« PHARMABOOST »). Libre : plus une énumération.
  code                String   @unique
  name                String
  description         String
  monthlyPriceCents   Int
  currency            String   @default("eur")
  /// Jours d'essai offerts à la souscription (30 = « premier mois offert »).
  trialDays           Int      @default(30)
  /// Limites du plan : { maxPharmacies, maxUsers, maxPrescriptionsPerMonth, ... }
  limits              Json     @default("{}")
  isActive            Boolean  @default(true)
  /// L'offre proposée par défaut quand on prépare un contrat.
  isDefault           Boolean  @default(false)
  /// Catalogue : prix annuel affiché (la facturation annuelle n'est pas branchée chez Stripe).
  annualPriceCents    Int?
  /// Catalogue : mise en service de la formule mensuelle, en centimes HT, due une seule fois. Vide : non renseignée.
  setupFeeCents       Int?
  /// Catalogue : mise en service de la formule annuelle, en centimes HT. 0 = offerte ; vide : non renseignée.
  annualSetupFeeCents Int?
  /// Tarif fondateur proposé aux premières officines : un tarif de catalogue, jamais appliqué d'office.
  foundingPriceCents  Int?
  /// Remise de catalogue proposée à la préparation d'un contrat (pourcentage entier) et son libellé.
  discountPercent     Int?
  discountLabel       String?
  /// Ce que comprend l'offre, et ses options : une ligne par élément.
  features            String[] @default([])
  options             String[] @default([])
  /// Nombre d'utilisateurs inclus, si l'offre en fixe un.
  maxUsers            Int?
  /// Ordre d'affichage au catalogue.
  sortOrder           Int      @default(0)
  stripeProductId     String?
  stripePriceId       String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  subscriptions Subscription[]
  contracts     Contract[]
  invites       SubscriptionInvite[]
  prospects     Prospect[]

  @@map("plans")
}

/// Statut de l'abonnement, aligné sur Stripe. `SUSPENDED` est propre à
/// PharmaBoost : l'accès est coupé par l'administrateur, quel que soit Stripe.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  planId               String
  status               SubscriptionStatus @default(TRIALING)
  seats                Int                @default(5)
  trialStartsAt        DateTime?
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime?
  /// Résiliation programmée à la fin de la période en cours.
  cancelAtPeriodEnd    Boolean            @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  /// Le client Stripe (`cus_…`). Un identifiant, jamais une autorisation :
  /// la portée vient toujours de la session.
  externalCustomerId   String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  /// Prochaine facture annoncée par Stripe, et dernier paiement.
  nextInvoiceAt        DateTime?
  lastPaymentAt        DateTime?
  lastPaymentCents     Int?
  lastPaymentFailedAt  DateTime?
  /// Suspension d'accès décidée par l'administrateur.
  suspendedAt          DateTime?
  suspendedReason      String?
  /// Le contrat qui fonde cet abonnement, s'il y en a un.
  contractId           String?
  /// Tarif contractuel mensuel HT de CETTE officine, en centimes. Figé à la
  /// souscription (contrat signé, sinon offre du moment) : une modification du
  /// catalogue ne le change jamais. Seule une modification explicite, tracée
  /// dans `SubscriptionPriceChange`, le fait évoluer.
  contractPriceCents   Int?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 Plan                      @relation(fields: [planId], references: [id])
  payments             BillingPayment[]
  priceChanges         SubscriptionPriceChange[]
  cancellationRequests CancellationRequest[]

  @@index([status])
  @@map("subscriptions")
}

/// Le lien d'activation envoyé au titulaire : un jeton PharmaBoost, dont seule
/// l'empreinte est conservée, qui ouvre un Checkout Stripe rattaché à CETTE
/// officine, cette offre, ce contrat. Renvoyer le lien ne crée pas un nouveau
/// jeton ; ouvrir le lien crée une session Checkout fraîche (les sessions
/// Stripe expirent en 24 h, pas le lien).
model SubscriptionInvite {
  id                String    @id @default(cuid())
  pharmacyId        String
  organizationId    String
  planId            String
  contractId        String?
  tokenHash         String    @unique
  sentTo            String
  sentAt            DateTime?
  sentCount         Int       @default(0)
  openedAt          DateTime?
  /// Le client Stripe créé pour cette officine au premier clic ; réutilisé
  /// à chaque nouvelle session Checkout pour ne pas créer de doublons.
  stripeCustomerId  String?
  /// Dernière session Checkout créée pour ce lien.
  checkoutSessionId String?
  checkoutCreatedAt DateTime?
  completedAt       DateTime?
  expiresAt         DateTime
  createdByAdminId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  pharmacy Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([pharmacyId])
  @@map("subscription_invites")
}

/// Une facture Stripe, telle que reçue par webhook : payée, échouée, ouverte.
model BillingPayment {
  id               String    @id @default(cuid())
  subscriptionId   String
  organizationId   String
  stripeInvoiceId  String    @unique
  /// PAID · FAILED · OPEN · VOID · UNCOLLECTIBLE · DRAFT
  status           String
  amountCents      Int
  currency         String    @default("eur")
  periodStart      DateTime?
  periodEnd        DateTime?
  paidAt           DateTime?
  failedAt         DateTime?
  attemptCount     Int       @default(0)
  hostedInvoiceUrl String?
  invoicePdfUrl    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("billing_payments")
}

/// Chaque notification Stripe reçue, une fois. L'identifiant d'événement est
/// unique : un webhook rejoué est reconnu et ignoré, jamais rejoué.
model BillingEvent {
  id             String    @id @default(cuid())
  stripeEventId  String    @unique
  type           String
  organizationId String?
  pharmacyId     String?
  summary        String
  /// L'objet Stripe, allégé (identifiants, statuts, montants, dates).
  payload        Json      @default("{}")
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  error          String?

  @@index([organizationId, receivedAt])
  @@index([receivedAt])
  @@map("billing_events")
}

// ===========================================================================
// UTILISATEURS, RÔLES, SESSIONS
// ===========================================================================

enum UserRole {
  OWNER // Titulaire / administrateur
  PHARMACIST // Pharmacien adjoint
  TECHNICIAN // Préparateur
  STUDENT // Étudiant / stagiaire
  VIEWER // Consultation seule
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id                     String     @id @default(cuid())
  organizationId         String
  email                  String     @unique
  passwordHash           String?
  /// Lien « définir / réinitialiser mon mot de passe » : empreinte du jeton,
  /// usage unique, durée limitée. Créé à l'accueil d'un titulaire ou sur demande.
  passwordResetTokenHash String?    @unique
  passwordResetExpiresAt DateTime?
  firstName              String
  lastName               String
  phone                  String?
  avatarUrl              String?
  status                 UserStatus @default(ACTIVE)
  /// Numéro RPPS pour les professionnels de santé (pharmaciens).
  rppsNumber             String?
  lastLoginAt            DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  deletedAt              DateTime?

  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships             Membership[]
  sessions                Session[]
  prescriptions           Prescription[]        @relation("PrescriptionCreatedBy")
  verifiedPrescriptions   Prescription[]        @relation("PrescriptionVerifiedBy")
  recommendationDecisions Recommendation[]
  recommendationEvents    RecommendationEvent[]
  documents               PatientDocument[]
  sales                   Sale[]
  stockMovements          StockMovement[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  pharmacyRules           PharmacyRule[]
  imports                 ImportJob[]
  stockDeposits           StockDeposit[]

  @@index([organizationId])
  @@map("users")
}

model Membership {
  id                 String   @id @default(cuid())
  userId             String
  pharmacyId         String
  role               UserRole @default(TECHNICIAN)
  /// Permissions accordées en plus du rôle (codes, cf. src/server/rbac/permissions.ts).
  grantedPermissions String[] @default([])
  /// Permissions retirées malgré le rôle.
  revokedPermissions String[] @default([])
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([userId, pharmacyId])
  @@index([pharmacyId])
  @@map("memberships")
}

model Session {
  id         String    @id @default(cuid())
  /// SHA-256 du jeton de session. Le jeton en clair n'est jamais stocké.
  tokenHash  String    @unique
  userId     String
  /// Officine active pour cette session (multi-officine d'un même groupe).
  pharmacyId String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ===========================================================================
// SUPER ADMIN PHARMA.AI (éditeur du logiciel)
// Volontairement séparé de `User` : un administrateur plateforme n'a aucun
// accès aux données patients par construction du modèle.
// ===========================================================================

/// Fichier stocké dans la base (ordonnance photographiée) quand aucun
/// stockage objet n'est branché. Même isolation que le reste : la clé commence
/// par l'identifiant de l'officine, et la lecture la vérifie.
model StoredFile {
  key        String   @id
  pharmacyId String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([pharmacyId])
  @@map("stored_files")
}

model PlatformAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  /// Lien « définir mon mot de passe » : seule l'empreinte du jeton est
  /// conservée, à usage unique et à durée limitée.
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?

  sessions PlatformAdminSession[]

  @@map("platform_admins")
}

model PlatformAdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_admin_sessions")
}

enum IncidentSeverity {
  INFO
  WARNING
  CRITICAL
}

model PlatformIncident {
  id         String           @id @default(cuid())
  /// Optionnel : incident lié à une officine précise (jamais de donnée patient).
  pharmacyId String?
  severity   IncidentSeverity @default(WARNING)
  code       String
  title      String
  detail     String
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([createdAt])
  @@map("platform_incidents")
}

/// Consommation IA par officine : pilotage des coûts et des quotas.
model AiUsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  pharmacyId     String
  provider       String
  operation      String
  model          String?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costMicroCents Int      @default(0)
  durationMs     Int      @default(0)
  succeeded      Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pharmacy     Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, createdAt])
  @@map("ai_usage_records")
}

// ===========================================================================
// PATIENTS (CRM officinal)
// ===========================================================================

enum PatientSex {
  FEMALE
  MALE
  UNSPECIFIED
}

model Patient {
  id         String     @id @default(cuid())
  pharmacyId String
  /// Référence interne affichée à l'écran (ex. PAT-0001).
  reference  String
  firstName  String
  lastName   String
  birthDate  DateTime?
  sex        PatientSex @default(UNSPECIFIED)

  email        String?
  phone        String?
  addressLine1 String?
  postalCode   String?
  city         String?

  /// Note commerciale, non médicale (préférences d'achat, langue...).
  commercialNotes String?

  /// Jeton de désinscription des suivis, porté par chaque message envoyé.
  /// Il ne donne accès à rien d'autre : il coupe les rappels, sans exposer la
  /// fiche ni toucher au dossier de soin, qui relève d'une autre obligation.
  followUpOptOutToken String?   @unique
  followUpOptOutAt    DateTime?

  isDemo       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Suppression logique — la purge définitive est pilotée par la politique
  /// de conservation (voir docs/RGPD.md).
  deletedAt    DateTime?
  anonymizedAt DateTime?

  pharmacy      Pharmacy              @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  healthProfile PatientHealthProfile?
  consents      PatientConsent[]
  prescriptions Prescription[]
  documents     PatientDocument[]
  sales         Sale[]
  interactions  PatientInteraction[]
  reminders     Reminder[]

  @@unique([pharmacyId, reference])
  @@index([pharmacyId, lastName])
  @@index([pharmacyId, createdAt])
  @@map("patients")
}

/// Données de santé — table séparée, champs libres chiffrés au niveau applicatif
/// (AES-256-GCM, cf. src/server/security/encryption.ts).
model PatientHealthProfile {
  id                         String  @id @default(cuid())
  patientId                  String  @unique
  /// Allergies déclarées (chiffré).
  allergiesEncrypted         String?
  /// Pathologies chroniques déclarées (chiffré).
  conditionsEncrypted        String?
  /// Traitements en cours hors ordonnance (chiffré).
  currentTreatmentsEncrypted String?
  /// Notes du pharmacien (chiffré).
  notesEncrypted             String?

  isPregnant        Boolean?
  isBreastfeeding   Boolean?
  weightKg          Float?
  heightCm          Float?
  renalImpairment   Boolean?
  hepaticImpairment Boolean?

  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_health_profiles")
}

enum ConsentType {
  DATA_PROCESSING // Traitement des données personnelles
  HEALTH_DATA // Traitement des données de santé
  ADVICE_SHARING // Réception de la fiche conseil
  /// Réception des suivis de traitement. Volontairement distinct des
  /// consentements marketing : un suivi thérapeutique n'est pas une offre
  /// commerciale, et les confondre reviendrait soit à bloquer un suivi
  /// légitime, soit à faire passer de la promotion pour du soin.
  FOLLOW_UP_MESSAGE
  MARKETING_EMAIL
  MARKETING_SMS
}

model PatientConsent {
  id                String      @id @default(cuid())
  patientId         String
  type              ConsentType
  granted           Boolean
  grantedAt         DateTime?
  revokedAt         DateTime?
  /// Comment le consentement a été recueilli (comptoir, formulaire, e-mail...).
  collectionMethod  String      @default("COUNTER")
  collectedByUserId String?
  /// Version du texte d'information présenté au patient.
  noticeVersion     String      @default("v1")
  createdAt         DateTime    @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, type])
  @@map("patient_consents")
}

enum InteractionType {
  PRESCRIPTION_RECEIVED
  ADVICE_GIVEN
  DOCUMENT_GENERATED
  DOCUMENT_VIEWED
  SALE_RECORDED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_SENT
  FOLLOW_UP_ANSWERED
  FOLLOW_UP_OPTED_OUT
  NOTE
}

/// Ce que le patient répond à un suivi. Trois réponses fermées, aucun texte
/// libre : un besoin de conseil ramène le patient vers son pharmacien, il ne
/// déclenche ni diagnostic ni modification de traitement.
enum FollowUpAnswer {
  BETTER
  SAME
  NEED_ADVICE
}

model PatientInteraction {
  id         String          @id @default(cuid())
  patientId  String
  pharmacyId String
  type       InteractionType
  summary    String
  metadata   Json            @default("{}")
  userId     String?
  createdAt  DateTime        @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@map("patient_interactions")
}

// ===========================================================================
// CATALOGUE & STOCK
// ===========================================================================

enum ProductCategory {
  PROBIOTIQUES
  VITAMINES
  MINERAUX
  MAGNESIUM
  HYGIENE
  DERMATOLOGIE
  DERMOCOSMETIQUE
  SOINS
  NUTRITION
  DISPOSITIFS_MEDICAUX
  PHYTOTHERAPIE
  SAISONNIER
  AUTRE
}

model Product {
  id             String          @id @default(cuid())
  pharmacyId     String
  organizationId String
  name           String
  brand          String?
  category       ProductCategory
  subCategory    String?
  /// Référence interne / SKU officine.
  reference      String
  ean            String?
  imageUrl       String?
  /// D'où vient la photo : « officine » (prise sur place) ou une base ouverte
  /// (« openbeautyfacts », « openproductsfacts », « openfoodfacts »), à créditer.
  imageSource    String?
  description    String?

  /// Allégations commerciales autorisées, validées par l'officine.
  /// Elles seules peuvent être reprises dans la fiche patient.
  commercialClaims  String[] @default([])
  /// Précautions d'emploi à afficher au pharmacien et, si pertinent, au patient.
  precautions       String[] @default([])
  /// Mots-clés d'appariement utilisés par le moteur de recommandation.
  matchingTags      String[] @default([])
  /// Contre-indications simples déclarées par l'officine (grossesse, enfant...).
  contraindications String[] @default([])

  purchasePriceCents Int   @default(0)
  salePriceCents     Int   @default(0)
  /// Taux de TVA en points de pourcentage (ex. 5.5, 10, 20).
  vatRate            Float @default(20)

  isActive Boolean @default(true)
  isDemo   Boolean @default(false)

  /// Quand et par quoi le produit a été rangé dans une catégorie et doté de ses
  /// étiquettes d'appariement : « HEURISTIC » (dictionnaire), « AI » (modèle,
  /// vocabulaire fermé), « PHARMACIST » (saisie à la main). Vide : produit
  /// jamais classé — le moteur ne peut pas le rapprocher d'un besoin.
  classifiedAt         DateTime?
  classificationSource String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  pharmacy        Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  stockItem       StockItem?
  stockMovements  StockMovement[]
  recommendations Recommendation[] @relation("RecommendationProduct")
  replacedIn      Recommendation[] @relation("RecommendationReplacedProduct")
  saleLines       SaleLine[]
  pharmacyRules   PharmacyRule[]

  barcodes ProductBarcode[]

  stockLots  StockLot[]
  vigilances ProductVigilance[]

  @@unique([pharmacyId, reference])
  @@index([pharmacyId, category])
  @@index([pharmacyId, isActive])
  @@index([ean])
  @@map("products")
}

model StockItem {
  id             String    @id @default(cuid())
  pharmacyId     String
  productId      String    @unique
  quantity       Int       @default(0)
  /// Seuil déclenchant l'alerte « stock faible ».
  alertThreshold Int       @default(5)
  location       String?
  lastCountedAt  DateTime?
  updatedAt      DateTime  @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, quantity])
  @@map("stock_items")
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  LOSS
  RETURN
  INVENTORY
  IMPORT
}

model StockMovement {
  id            String            @id @default(cuid())
  pharmacyId    String
  productId     String
  type          StockMovementType
  quantityDelta Int
  quantityAfter Int
  reason        String?
  userId        String?
  saleId        String?
  createdAt     DateTime          @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Une vente ne décompte un produit qu'une fois, quoi qu'il arrive au clic.
  @@unique([saleId, productId])
  @@index([pharmacyId, createdAt])
  @@index([productId, createdAt])
  @@map("stock_movements")
}

enum ImportKind {
  PRODUCTS
  PATIENTS
  STOCK
  DRUG_STOCK
}

enum ImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// Un fichier de stock envoyé par le titulaire depuis son espace PharmaBoost.
/// Le fichier d'origine est gardé (stockage privé, 90 jours) ; le stock de
/// l'officine est mis à jour sans intervention, sauf quand le fichier est
/// bien plus petit que le stock connu : il attend alors la décision de
/// l'équipe (HELD). Aucune donnée de patient dans un fichier de stock.
enum StockDepositStatus {
  /// Reçu, traitement en cours.
  RECEIVED
  /// Appliqué au stock de l'officine.
  APPLIED
  /// Reçu mais non appliqué : l'équipe PharmaBoost doit trancher.
  HELD
  /// Illisible ou refusé : le stock n'a pas bougé.
  FAILED
  /// Écarté par l'équipe : le stock n'a pas bougé.
  REJECTED
}

model StockDeposit {
  id            String             @id @default(cuid())
  pharmacyId    String
  /// Le membre de l'officine qui a envoyé le fichier.
  userId        String?
  fileName      String
  fileSize      Int
  /// Empreinte SHA-256 du fichier : reconnaître un double envoi.
  fileSha256    String
  /// Clé du fichier d'origine dans le stockage privé ; vide une fois purgé.
  storageKey    String?
  status        StockDepositStatus @default(RECEIVED)
  /// D'où vient le fichier : WEB (espace du titulaire), AGENT (le petit facteur du serveur) ou CONSOLE (déposé par l'équipe).
  source        String             @default("WEB")
  /// Lignes valides détectées dans le fichier.
  lines         Int?
  created       Int?
  updated       Int?
  invalid       Int?
  /// Produits absents du fichier remis à zéro.
  zeroed        Int?
  /// Lignes de stock connues avant l'envoi (pour juger la taille du fichier).
  knownLines    Int?
  /// L'erreur, ou la raison pour laquelle l'équipe doit trancher.
  message       String?
  /// L'import ligne à ligne produit par ce dépôt.
  importJobId   String?
  receivedAt    DateTime           @default(now())
  appliedAt     DateTime?
  /// L'administrateur de la console qui a tranché (« HELD ») ou relancé.
  decidedById   String?
  decidedAt     DateTime?
  /// Date de suppression du fichier d'origine (purge à 90 jours).
  fileDeletedAt DateTime?

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pharmacyId, receivedAt])
  @@index([status, receivedAt])
  @@map("stock_deposits")
}

model ImportJob {
  id          String       @id @default(cuid())
  pharmacyId  String
  kind        ImportKind
  status      ImportStatus @default(PENDING)
  fileName    String
  totalRows   Int          @default(0)
  createdRows Int          @default(0)
  updatedRows Int          @default(0)
  errorRows   Int          @default(0)
  /// Détail ligne à ligne des erreurs rencontrées.
  errors      Json         @default("[]")
  /// Correspondance colonnes du fichier → champs (nom, code, quantité, prix…).
  mapping     Json?
  /// Les lignes analysées, en attente de validation : rien n'est écrit en
  /// stock avant que le titulaire ait vu l'aperçu et validé.
  payload     Json?
  /// Le résumé de l'aperçu : détectés, reconnus, à vérifier, non reconnus.
  summary     Json?
  userId      String?
  createdAt   DateTime     @default(now())
  finishedAt  DateTime?

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pharmacyId, createdAt])
  @@map("import_jobs")
}

// ===========================================================================
// CATALOGUE NATIONAL DES MÉDICAMENTS — source : Base de Données Publique des
// Médicaments (BDPM), base-donnees-publique.medicaments.gouv.fr
//
// Ces tables sont PARTAGÉES par toutes les officines et ne sont jamais copiées
// dans une pharmacie : une officine ne possède que des lignes de stock qui les
// référencent. C'est ce qui permet à une resynchronisation mensuelle de ne
// jamais toucher au stock de qui que ce soit.
//
// Trois règles de la licence de réutilisation sont matérialisées ici :
//   • les valeurs officielles sont stockées telles quelles, jamais réécrites ;
//   • la date de mise à jour PUBLIÉE PAR LA SOURCE est conservée (et non la
//     date de notre import), pour être affichée à côté de la source ;
//   • rien n'est supprimé : ce qui disparaît d'un fichier est marqué retiré.
//
// Tout contenu rédigé par Pharma.ai (explication patient, conseil de prise…)
// vit AILLEURS et porte sa propre origine : il ne doit jamais pouvoir passer
// pour de la donnée officielle.
// ===========================================================================

enum ReferenceSource {
  BDPM
  /// Référentiel d'interactions médicamenteuses, fourni par l'officine.
  INTERACTIONS
}

enum ReferenceImportStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Journal des synchronisations du catalogue national.
///
/// C'est cette table qui répond à « d'où vient cette information et de quand
/// date-t-elle ? » — la licence BDPM impose de pouvoir l'afficher.
model ReferenceImport {
  id     String          @id @default(cuid())
  source ReferenceSource @default(BDPM)

  /// Date de mise à jour annoncée par la source. À ne pas confondre avec
  /// `startedAt` : c'est celle-ci qui doit être affichée au pharmacien.
  sourceUpdatedAt DateTime?
  sourceUrl       String

  startedAt  DateTime              @default(now())
  finishedAt DateTime?
  status     ReferenceImportStatus @default(RUNNING)

  /// Une entrée par fichier traité : nom, lignes lues, créées, modifiées,
  /// ignorées et le motif des lignes ignorées.
  fileReports Json    @default("[]")
  error       String?
  /// Exécution à blanc : rien n'a été écrit dans le catalogue.
  isDryRun    Boolean @default(false)

  @@index([source, startedAt])
  @@map("reference_imports")
}

// ---------------------------------------------------------------------------
// INTERACTIONS MÉDICAMENTEUSES
//
// Rien ici n'est produit par Pharma.ai. Chaque couple vient d'un référentiel
// fourni par l'officine, avec son nom, sa version et sa date. Ce qui n'est pas
// dans le fichier n'existe pas : aucune interaction n'est déduite, complétée
// ni extrapolée d'une classe vers une autre.
//
// Conséquence assumée : tant qu'aucun référentiel n'est chargé, l'application
// dit qu'elle n'analyse pas les interactions. Un écran muet ne vaut pas une
// vérification.
// ---------------------------------------------------------------------------

/// Les quatre niveaux du thésaurus national, dans ses propres termes.
enum InteractionSeverity {
  /// Contre-indication — l'association ne doit pas être faite.
  CONTRAINDICATION
  /// Association déconseillée.
  NOT_RECOMMENDED
  /// Précaution d'emploi.
  PRECAUTION
  /// À prendre en compte.
  TO_CONSIDER
}

/// Un côté d'un couple : soit une substance active, soit une classe.
enum InteractionSideKind {
  SUBSTANCE
  CLASS
}

/// Un couple en interaction, tel que le référentiel le déclare.
model DrugInteractionRule {
  id String @id @default(cuid())

  /// Libellés repris tels quels — ce sont eux qui s'affichent au pharmacien.
  leftLabel  String
  rightLabel String
  /// Formes normalisées (sans accents, majuscules) servant à l'appariement.
  /// Toujours rangées dans l'ordre lexicographique : un couple n'a qu'une
  /// écriture, quel que soit l'ordre des lignes de l'ordonnance.
  leftKey    String
  rightKey   String
  leftKind   InteractionSideKind
  rightKind  InteractionSideKind

  severity InteractionSeverity
  /// Le risque, mot pour mot depuis la source. Jamais reformulé.
  risk     String
  /// La conduite à tenir, mot pour mot. Absente si la source ne la donne pas.
  guidance String?

  sourceName      String
  sourceVersion   String
  sourceUrl       String?
  /// Date de la version du référentiel, jamais celle de notre import.
  sourceUpdatedAt DateTime?

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([leftKey, rightKey, severity, sourceName])
  @@index([leftKey])
  @@index([rightKey])
  @@map("drug_interaction_rules")
}

/// Appartenance d'une substance à une classe du référentiel.
///
/// Sans cette table, une règle exprimée au niveau d'une classe ne pourrait
/// jamais être rapprochée d'une ordonnance, qui ne contient que des substances.
model DrugInteractionClassMember {
  id String @id @default(cuid())

  classLabel     String
  classKey       String
  substanceLabel String
  substanceKey   String

  /// Vrai lorsque la ligne ne décrit pas une classe mais une CORRESPONDANCE de
  /// vocabulaire : « AMOXICILLINE BASE » (catalogue national) désigne la même
  /// chose que « amoxicilline » (référentiel d'interactions). Sans cette
  /// déclaration, l'appariement strict raterait l'interaction — un faux négatif
  /// dans une fonction de sécurité. Elle est fournie par l'officine, jamais
  /// devinée.
  isAlias Boolean @default(false)

  sourceName String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([classKey, substanceKey, sourceName])
  @@index([substanceKey])
  @@map("drug_interaction_class_members")
}

/// Une spécialité pharmaceutique — fichier CIS_bdpm, 12 colonnes.
model DrugSpecialty {
  id      String @id @default(cuid())
  /// Code Identifiant de Spécialité. Clé naturelle, stable dans le temps.
  cisCode String @unique

  name                 String
  /// Le nom sans accents et en majuscules, pour la recherche au comptoir.
  /// Dérivé de `name`, jamais substitué à lui : la valeur officielle reste
  /// intacte juste à côté. Vide tant que l'import ne l'a pas rempli — la
  /// recherche interroge alors `name` seul, sans jamais rien rendre de faux.
  searchName           String   @default("")
  pharmaceuticalForm   String?
  /// Voies d'administration. La source les sépare par « ; ».
  administrationRoutes String[] @default([])

  authorizationStatus         String?
  authorizationProcedure      String?
  /// « Commercialisée » / « Non commercialisée ».
  marketingStatus             String?
  authorizedAt                DateTime?
  /// Statut BdM : « Warning disponibilité », « Alerte »… Vide le plus souvent.
  bdmStatus                   String?
  europeanAuthorizationNumber String?
  /// Titulaires de l'AMM. Séparés par « ; » dans la source (rare).
  holders                     String[]  @default([])
  enhancedMonitoring          Boolean   @default(false)

  /// Dernière synchronisation ayant vu cette ligne dans le fichier source.
  lastSeenAt  DateTime  @default(now())
  /// Renseigné quand la ligne disparaît de la source. On ne supprime jamais :
  /// un stock d'officine ou une vente passée peut encore la référencer.
  withdrawnAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  presentations          DrugPresentation[]
  compositions           DrugComposition[]
  prescriptionConditions DrugPrescriptionCondition[]
  genericMemberships     DrugGenericMember[]
  smrOpinions            DrugSmrOpinion[]
  prescriptionLines      PrescriptionLine[]

  @@index([name])
  @@index([marketingStatus])
  @@map("drug_specialties")
}

/// Une présentation — la boîte précise. Fichier CIS_CIP_bdpm, 13 colonnes.
///
/// `cip13` est le code-barres imprimé sur la boîte : scanner, c'est lire
/// directement cette clé.
model DrugPresentation {
  id          String  @id @default(cuid())
  specialtyId String
  /// Code Identifiant de Présentation à 13 chiffres. Vérifié unique sur la
  /// base réelle, et toujours préfixé « 3400 » pour les médicaments français.
  cip13       String  @unique
  /// Photo de la boîte, quand une base ouverte la connaît par son code-barres.
  imageUrl    String?
  imageSource String?
  cip7        String  @unique

  label                  String
  administrativeStatus   String?
  /// « Déclaration de commercialisation », « Déclaration d'arrêt… »
  marketingStatus        String?
  marketingDeclaredAt    DateTime?
  /// Agrément aux collectivités : « oui » / « non » dans la source.
  approvedForCommunities Boolean?

  /// Taux de remboursement tel qu'écrit dans la source — elle contient aussi
  /// bien « 65% » que « 65 % ». Conservé sans retouche.
  reimbursementRateRaw String?
  /// Le même taux en points de pourcentage, pour pouvoir filtrer. Dérivé,
  /// jamais substitué à la valeur d'origine.
  reimbursementRate    Int?

  /// Prix hors honoraire de dispensation, en centimes. Absent pour les
  /// présentations non remboursées — un tiers d'entre elles.
  priceCents          Int?
  /// Prix total (prix + honoraires), en centimes.
  totalPriceCents     Int?
  /// Honoraire de dispensation, en centimes.
  dispensingFeeCents  Int?
  reimbursementNotice String?

  lastSeenAt  DateTime  @default(now())
  withdrawnAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  specialty       DrugSpecialty       @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  /// Les officines qui détiennent cette boîte. Le catalogue national ne sait
  /// rien d'elles : c'est le stock qui référence la présentation, jamais
  /// l'inverse.
  pharmacyStocks  PharmacyDrugStock[]
  recommendations Recommendation[]
  /// Ce que la base tarifaire de l'Assurance Maladie dit de cette boîte.
  coverageStatus  DrugCoverageStatus?

  @@index([specialtyId])
  @@index([marketingStatus])
  @@map("drug_presentations")
}

/// Le statut de prise en charge d'une boîte, lu sur la fiche CIP de la Base
/// des médicaments et informations tarifaires (Assurance Maladie).
///
/// C'est la seule source qui dise si un médicament relève de l'ordonnance de
/// médicaments d'exception — l'information qui, ignorée, produit un rejet de
/// facturation. Une ligne par boîte, réécrite à chaque synchronisation ; les
/// changements sont journalisés dans `DrugRegulationChange`.
model DrugCoverageStatus {
  id             String @id @default(cuid())
  presentationId String @unique
  cip13          String @unique

  /// « Statut d'Exception : Oui » sur la fiche.
  isException       Boolean
  /// « Médicament Spécifique » — conservé tel quel, jamais interprété.
  isSpecific        Boolean
  /// « Nature du médicament » — « A » le plus souvent.
  nature            String?
  /// Désignation telle que la CNAM l'écrit.
  designation       String
  /// « Médicament NON Remboursable aux Assurés Sociaux » affiché sur la fiche.
  notReimbursable   Boolean   @default(false)
  /// Période d'homologation aux assurés sociaux la plus récente.
  coverageStartsAt  DateTime?
  coverageEndsAt    DateTime?
  coverageEndReason String?

  sourceName      String
  sourceVersion   String?
  /// Date de mise à jour annoncée par la base, jamais celle de notre lecture.
  sourceUpdatedAt DateTime?
  /// Notre dernière lecture réussie de la fiche.
  checkedAt       DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  presentation DrugPresentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  @@index([isException])
  @@map("drug_coverage_statuses")
}

enum RegulationChangeKind {
  /// Le statut « médicament d'exception » a changé de valeur.
  EXCEPTION_STATUS
  /// La fin d'homologation aux assurés sociaux a changé (radiation, prolongation…).
  COVERAGE_END
  /// Une condition de prescription ou de délivrance est apparue dans la BDPM.
  CONDITION_ADDED
  /// Une condition de prescription ou de délivrance a disparu de la BDPM.
  CONDITION_REMOVED
}

/// Une évolution réglementaire constatée entre deux synchronisations.
///
/// C'est le fil « dernières évolutions » de l'onglet Réglementation : ce que
/// les pharmaciens n'ont aucun moyen de suivre jour après jour. Chaque ligne
/// dit ce qui a changé, pour quel médicament, d'après quelle source et à
/// quelle date de source. On ne supprime jamais : c'est un journal.
model DrugRegulationChange {
  id String @id @default(cuid())

  kind       RegulationChangeKind
  /// Nom du médicament au moment du constat, pour l'affichage.
  drugName   String
  cisCode    String?
  cip13      String?
  /// Valeur avant / après, en clair (« Non » → « Oui », un libellé de condition…).
  before     String?
  after      String?
  sourceName String
  /// Date de mise à jour annoncée par la source au moment du constat.
  sourceDate DateTime?
  detectedAt DateTime             @default(now())

  @@index([detectedAt])
  @@index([cisCode])
  @@map("drug_regulation_changes")
}

/// Une substance, dédoublonnée par son code officiel.
///
/// La source écrit parfois la même substance de plusieurs façons
/// (« RANITIDINE (CHLORHYDRATE DE) » et « CHLORHYDRATE DE RANITIDINE » portent
/// le code 25783) : 562 codes sur 3 352 sont dans ce cas. On retient la
/// graphie la plus fréquente comme libellé de référence, sans jamais corriger
/// la source — chaque ligne de composition conserve la graphie exacte qu'elle
/// portait.
model DrugSubstance {
  id          String   @id @default(cuid())
  code        String   @unique
  /// Graphie la plus fréquente rencontrée dans le fichier.
  label       String
  /// Le libellé sans accents et en majuscules, pour la recherche.
  searchLabel String   @default("")
  /// Les autres graphies rencontrées pour ce même code.
  aliases     String[] @default([])

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  compositions DrugComposition[]

  @@index([label])
  @@map("drug_substances")
}

/// Composition qualitative et quantitative — fichier CIS_COMPO_bdpm.
///
/// `nature` vaut « SA » (substance active, le sel réellement présent) ou
/// « FT » (fraction thérapeutique, la molécule active). Les deux lignes d'un
/// même couple partagent `linkNumber` : c'est la FT qui intéresse le moteur de
/// conseil, la SA qui figure sur la boîte.
model DrugComposition {
  id          String @id @default(cuid())
  specialtyId String
  substanceId String

  /// Élément pharmaceutique décrit (« comprimé », « gélule »…).
  element         String
  /// Graphie exacte de la substance sur cette ligne, telle qu'écrite par la
  /// source.
  substanceLabel  String
  dosage          String?
  dosageReference String?
  /// « SA » ou « FT ».
  nature          String
  /// Numéro reliant une substance active à sa fraction thérapeutique.
  linkNumber      String?

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  specialty DrugSpecialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  substance DrugSubstance @relation(fields: [substanceId], references: [id], onDelete: Cascade)

  @@unique([specialtyId, element, substanceId, nature, linkNumber])
  @@index([substanceId])
  @@map("drug_compositions")
}

/// Conditions de prescription et de délivrance — fichier CIS_CPD_bdpm.
/// Une ligne par condition : « liste I », « stupéfiant », « réservé à… ».
model DrugPrescriptionCondition {
  id          String @id @default(cuid())
  specialtyId String
  label       String

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  specialty DrugSpecialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([specialtyId, label])
  @@index([label])
  @@map("drug_prescription_conditions")
}

/// Un groupe générique — fichier CIS_GENER_bdpm.
model DrugGenericGroup {
  id         String @id @default(cuid())
  /// Identifiant du groupe dans la source.
  externalId String @unique
  label      String

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members DrugGenericMember[]

  @@map("drug_generic_groups")
}

/// Appartenance d'une spécialité à un groupe générique.
///
/// `type` reprend la codification de la source : 0 princeps, 1 générique,
/// 2 générique par complémentarité posologique, 4 substituable.
model DrugGenericMember {
  id          String @id @default(cuid())
  groupId     String
  specialtyId String
  type        Int
  sortOrder   Int?

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  group     DrugGenericGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  specialty DrugSpecialty    @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([groupId, specialtyId])
  @@index([specialtyId])
  @@map("drug_generic_members")
}

/// Avis de service médical rendu de la HAS — fichier CIS_HAS_SMR_bdpm.
///
/// Aucune clé naturelle unique : la source contient plusieurs avis pour un même
/// couple (CIS, dossier, date). Les avis d'une spécialité sont donc remplacés
/// en bloc à chaque synchronisation plutôt que rapprochés ligne à ligne.
model DrugSmrOpinion {
  id          String @id @default(cuid())
  specialtyId String

  hasDossierCode String?
  evaluationType String?
  opinionDate    DateTime?
  /// « Important », « Modéré », « Faible », « Insuffisant »…
  value          String?
  label          String?

  createdAt DateTime @default(now())

  specialty DrugSpecialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@index([specialtyId])
  @@map("drug_smr_opinions")
}

/// Comment une ligne est entrée dans le stock de l'officine.
enum DrugStockSource {
  /// Code-barres lu au comptoir.
  SCAN
  /// Import en masse d'une liste de codes.
  IMPORT
  /// Saisie à l'écran.
  MANUAL
}

/// Ce qu'UNE officine détient du catalogue national.
///
/// C'est la seule table qui relie une pharmacie à un médicament, et elle ne
/// contient AUCUNE donnée officielle recopiée : seulement une référence, une
/// quantité et ce que l'officine en dit. Deux conséquences voulues :
///
///   • une resynchronisation mensuelle du catalogue national ne peut pas
///     toucher au stock d'une officine — les deux ne partagent aucune colonne ;
///   • une grosse pharmacie ne duplique pas 20 000 fiches produit : elle pose
///     20 000 lignes de trois champs.
///
/// La quantité porte à elle seule la règle commerciale : une boîte à zéro est
/// référencée mais pas détenue, donc jamais proposée comme recommandation.
model PharmacyDrugStock {
  id             String @id @default(cuid())
  pharmacyId     String
  presentationId String

  quantity       Int             @default(0)
  /// Seuil déclenchant l'alerte « stock faible ». 0 = pas d'alerte.
  alertThreshold Int             @default(0)
  /// Prix de vente TTC pratiqué par CETTE officine, en centimes. Absent = le
  /// prix public du catalogue national fait foi.
  priceCents     Int?
  location       String?
  source         DrugStockSource @default(MANUAL)
  lastCountedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy     Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  presentation DrugPresentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, presentationId])
  @@index([pharmacyId, quantity])
  @@map("pharmacy_drug_stocks")
}

// ===========================================================================
// RÉFÉRENTIEL MÉDICAMENTEUX
// Un LLM n'est PAS une base médicamenteuse. Cette table matérialise la source
// pharmaceutique branchée (BDPM, base éditeur...). Le jeu livré est FICTIF et
// marqué comme tel (`isDemoData = true`).
// ===========================================================================

/// Classification d'un PRODUIT (parapharmacie, dispositif, médicament conseil)
/// dans les catégories et le vocabulaire fermé des règles de conseil, mise en
/// cache par nom normalisé. Un nom de produit n'est pas une donnée de santé :
/// la table est partagée entre officines, et une officine qui importe « Ultra-
/// Levure 200 mg » bénéficie de la classification déjà faite pour une autre.
model ProductClassification {
  id         String   @id @default(cuid())
  key        String   @unique
  category   String
  tags       String[] @default([])
  confidence Float
  /// « HEURISTIC » (dictionnaire), « AI » (modèle), « PHARMACIST ».
  source     String
  providerId String?
  model      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("product_classifications")
}

/// Classification d'un médicament par le modèle, mise en cache.
///
/// La substance, le code ATC et la classe d'un médicament ne changent pas
/// d'une ordonnance à l'autre : une fois classé, un médicament ne repasse plus
/// par le modèle. C'est ce qui rend l'analyse au comptoir locale et immédiate.
/// La clé est le nom tel qu'écrit sur l'ordonnance, normalisé.
model DrugClassification {
  id                String    @id @default(cuid())
  key               String    @unique
  substance         String?
  atcCode           String?
  therapeuticClass  String?
  commonSideEffects String[]  @default([])
  confidence        Float
  providerId        String
  model             String
  /// Renseigné lorsqu'un pharmacien a confirmé la classification.
  validatedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("drug_classifications")
}

model DrugReference {
  id                 String   @id @default(cuid())
  /// Code CIS (base de données publique des médicaments) lorsqu'il existe.
  cisCode            String?  @unique
  name               String
  /// Dénomination commune internationale.
  inn                String?
  atcCode            String?
  therapeuticClass   String?
  form               String?
  strength           String?
  /// Effets indésirables fréquents à connaître au comptoir.
  commonSideEffects  String[] @default([])
  /// Classes/substances avec lesquelles une interaction est documentée.
  interactionClasses String[] @default([])
  /// Populations nécessitant une vigilance particulière.
  cautionPopulations String[] @default([])
  /// Explication vulgarisée validée, destinée au patient.
  patientExplanation String?
  intakeAdvice       String?

  sourceName    String
  sourceVersion String
  sourceUrl     String?
  /// TRUE tant que la donnée provient du jeu de démonstration fictif.
  isDemoData    Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([inn])
  @@map("drug_references")
}

// ===========================================================================
// ORDONNANCES
// ===========================================================================

enum PrescriptionSource {
  PHOTO
  SCAN
  IMAGE_UPLOAD
  PDF_UPLOAD
  MANUAL
  /// Boîtes passées à la douchette dans le LGO, captées par l'agent du poste de caisse.
  COUNTER_SCAN
}

enum PrescriptionStatus {
  DRAFT
  EXTRACTING
  NEEDS_VERIFICATION
  VERIFIED
  ANALYZING
  ANALYZED
  VALIDATED
  DELIVERED
  CANCELLED
  FAILED
}

model Prescription {
  id          String             @id @default(cuid())
  pharmacyId  String
  patientId   String?
  reference   String
  status      PrescriptionStatus @default(DRAFT)
  source      PrescriptionSource @default(MANUAL)
  /// Le poste de caisse dont viennent les bips (source COUNTER_SCAN).
  counterPost String?

  prescriberName String?
  prescriberRpps String?
  prescribedAt   DateTime?

  /// Chemin/clé du fichier d'origine dans le fournisseur de stockage.
  fileKey      String?
  fileMimeType String?
  fileName     String?

  /// Confiance globale de l'extraction (0 → 1).
  ocrConfidence Float?
  ocrProvider   String?

  createdByUserId  String?
  verifiedByUserId String?
  verifiedAt       DateTime?
  validatedAt      DateTime?

  isDemo    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  patient    Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  createdBy  User?    @relation("PrescriptionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  verifiedBy User?    @relation("PrescriptionVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  lines           PrescriptionLine[]
  analysisRuns    AnalysisRun[]
  recommendations Recommendation[]
  documents       PatientDocument[]
  sales           Sale[]
  sealedDocuments SealedDocument[]

  @@unique([pharmacyId, reference])
  @@index([pharmacyId, status])
  @@index([pharmacyId, createdAt])
  @@index([patientId])
  @@map("prescriptions")
}

/// Comment une ligne d'ordonnance a été rattachée au catalogue national.
enum DrugIdentificationSource {
  /// Rapprochement automatique sur le nom, accepté au-dessus du seuil ET sans
  /// ambiguïté de substance.
  AUTO
  /// Choisi explicitement par un professionnel.
  PHARMACIST
  /// Lu au code-barres sur la boîte.
  SCAN
}

enum LineStatus {
  EXTRACTED
  NEEDS_REVIEW
  CONFIRMED
  REJECTED
}

model PrescriptionLine {
  id             String  @id @default(cuid())
  prescriptionId String
  position       Int
  /// Texte brut tel que lu sur l'ordonnance — jamais réécrit par l'IA.
  rawText        String?

  drugName            String?
  /// Couche ÉDITORIALE : ce que Pharma.ai raconte du médicament (explication
  /// patient, conseils de prise). Rédigée, jamais officielle.
  drugReferenceId     String?
  /// Couche OFFICIELLE : la spécialité du catalogue national. Elle dit ce que
  /// le médicament EST — substances, forme, conditions de délivrance — avec sa
  /// source et sa date. Les deux ne doivent jamais être confondues.
  drugSpecialtyId     String?
  identifiedBy        DrugIdentificationSource?
  /// Score du rapprochement automatique, conservé pour rendre la décision
  /// auditable : on doit pouvoir dire POURQUOI cette ligne pointe là.
  identificationScore Float?
  dosage              String?
  form                String?
  posology            String?
  /// Répartition des prises, telle que confirmée par le pharmacien :
  /// { morning, noon, evening, bedtime, mealTiming, times }.
  /// NULL tant qu'aucune saisie structurée n'a eu lieu — le plan patient
  /// retombe alors sur le texte de la posologie plutôt que sur une
  /// répartition devinée. Voir src/core/posology/.
  schedule            Json?
  durationDays        Int?
  quantity            Int?
  instructions        String?

  status           LineStatus @default(EXTRACTED)
  /// Confiance par champ : { drugName: 0.94, dosage: 0.41, ... }
  /// Toute valeur < seuil déclenche une vérification humaine explicite.
  fieldConfidence  Json       @default("{}")
  /// Champs que l'extraction n'a pas su lire — jamais inventés.
  unreadableFields String[]   @default([])

  correctedByUserId String?
  correctedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescription     Prescription                  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  explanation      TreatmentExplanation?
  /// Les points réglementaires que le pharmacien a cochés pour cette ligne.
  regulationChecks PrescriptionRegulationCheck[]
  /// `SetNull` et non `Cascade` : une spécialité qui disparaîtrait du
  /// catalogue ne doit pas emporter la ligne d'ordonnance qui la citait.
  specialty        DrugSpecialty?                @relation(fields: [drugSpecialtyId], references: [id], onDelete: SetNull)

  @@unique([prescriptionId, position])
  @@map("prescription_lines")
}

/// Un point réglementaire vérifié par le pharmacien sur une ligne d'ordonnance
/// (« ordonnance d'exception présente », « ordonnance sécurisée vérifiée »…).
///
/// Coché, il dit qui a vérifié et quand : c'est ce que l'on montre en cas de
/// contrôle. Décoché, la ligne est supprimée — un point non vérifié n'a pas
/// d'histoire à raconter.
model PrescriptionRegulationCheck {
  id              String   @id @default(cuid())
  prescriptionId  String
  lineId          String
  /// Le code de l'alerte (EXCEPTION_FORM, NARCOTIC…), cf. src/core/regulation.
  code            String
  checkedByUserId String
  checkedAt       DateTime @default(now())

  line PrescriptionLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, code])
  @@index([prescriptionId])
  @@map("prescription_regulation_checks")
}

// ===========================================================================
// MOTEUR IA — ANALYSE, SÉCURITÉ, RECOMMANDATIONS
// ===========================================================================

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

model AnalysisRun {
  id             String         @id @default(cuid())
  pharmacyId     String
  prescriptionId String
  status         AnalysisStatus @default(PENDING)
  /// Version du moteur métier — indispensable à la relecture a posteriori.
  engineVersion  String
  /// Fournisseurs effectivement utilisés : { ocr, ai, knowledge }.
  providers      Json           @default("{}")
  /// Instantané des données d'entrée au moment de l'analyse.
  inputSnapshot  Json           @default("{}")
  /// Trace ordonnée des étapes du pipeline (sécurité → … → commercial).
  traceJson      Json           @default("[]")
  /// Raisons ayant bloqué tout ou partie de l'analyse.
  blockedReasons String[]       @default([])
  /// Ce que la compréhension IA a produit : contexte, classification par
  /// ligne, besoins et écarts de validation. Relisible des mois plus tard.
  understanding  Json?
  /// L'issue de l'analyse, en un mot (src/core/ai/outcome.ts) : PROPOSALS,
  /// NO_RELEVANT_NEED, STOCK_NOT_CONFIGURED, OUT_OF_STOCK… C'est ce qui
  /// permet de dire au comptoir POURQUOI rien n'est proposé, et au titulaire
  /// combien d'ordonnances ont donné lieu à une proposition.
  outcome        String?
  isDemo         Boolean        @default(false)

  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  errorMessage String?

  pharmacy        Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription    Prescription        @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  opportunities   AdviceOpportunity[]
  recommendations Recommendation[]
  safetyFindings  SafetyFinding[]

  @@index([pharmacyId, startedAt])
  @@index([prescriptionId])
  @@map("analysis_runs")
}

enum ExplanationSource {
  REFERENTIAL // Issue du référentiel médicamenteux branché
  PROFESSIONAL // Saisie/validée par le pharmacien
  DEMO // Jeu de démonstration fictif
  UNAVAILABLE // Information non disponible — rien n'est inventé
}

model TreatmentExplanation {
  id                 String            @id @default(cuid())
  prescriptionLineId String            @unique
  purpose            String?
  instructions       String?
  tips               String[]          @default([])
  precautions        String[]          @default([])
  source             ExplanationSource @default(UNAVAILABLE)
  sourceRefs         String[]          @default([])
  confidence         Float             @default(0)
  requiresReview     Boolean           @default(true)
  approvedByUserId   String?
  approvedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  line PrescriptionLine @relation(fields: [prescriptionLineId], references: [id], onDelete: Cascade)

  @@map("treatment_explanations")
}

enum SafetySeverity {
  INFO
  CAUTION
  WARNING
  BLOCKING
}

model SafetyFinding {
  id            String         @id @default(cuid())
  analysisRunId String
  severity      SafetySeverity
  code          String
  message       String
  /// Élément concerné : ligne d'ordonnance, catégorie de conseil, produit...
  subjectType   String
  subjectId     String?
  source        String
  /// Contenu structuré d'une vigilance (interaction, contre-indication,
  /// surveillance, dépistage) : ce que la carte du comptoir affiche.
  details       Json?
  createdAt     DateTime       @default(now())

  /// Acquittement professionnel. Tant qu'une alerte BLOCKING n'est pas
  /// acquittée, l'écran de vente n'ouvre pas la zone des conseils : on ne vend
  /// rien par-dessus une alerte non lue. L'horodatage et l'auteur sont
  /// conservés — l'acquittement est un acte, pas un simple état d'affichage.
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId])
  @@map("safety_findings")
}

/// Opportunité de conseil identifiée AVANT tout appariement produit.
/// L'étape est volontairement séparée du catalogue : on détermine d'abord la
/// pertinence, seulement ensuite ce que l'officine peut proposer.
model AdviceOpportunity {
  id                   String          @id @default(cuid())
  analysisRunId        String
  category             ProductCategory
  title                String
  /// Pourquoi ce conseil est envisagé, en langage pharmacien.
  rationale            String
  clinicalContext      String?
  safetyNotes          String[]        @default([])
  /// 0 → 100 : priorité clinique/conseil, indépendante de toute marge.
  priority             Int             @default(50)
  isBlocked            Boolean         @default(false)
  blockReason          String?
  /// Le besoin identifié par la compréhension IA qui a déclenché la règle.
  needKey              String?
  /// La question à poser au patient, écrite dans la règle de conseil.
  question             String?
  /// Vrai tant que la proposition attend la réponse du patient.
  requiresConfirmation Boolean         @default(false)
  /// La réponse du patient : oui, non, ou pas encore posée.
  answer               Boolean?
  answeredAt           DateTime?
  answeredByUserId     String?
  /// Pourquoi le modèle a vu ce besoin ici — pour le pharmacien uniquement.
  aiJustification      String?
  /// La règle de conseil qui a produit l'opportunité, et sa version : on doit
  /// pouvoir relire, des mois plus tard, quelle règle a parlé au comptoir.
  ruleKey              String?
  ruleVersion          String?
  /// Le « pourquoi » une fois le besoin confirmé par le patient.
  confirmedReason      String?
  /// Ce que le conseil apporte dans ce contexte, en trois mots-clés écrits
  /// dans la règle — jamais tirés d'un argumentaire produit.
  benefits             String[]        @default([])
  /// Les lignes d'ordonnance (PrescriptionLine.id) qui ont déclenché ce
  /// conseil : c'est ce qui permet de l'afficher sous le médicament concerné.
  /// Vide : conseil propre au patient, ou analyse antérieure à ce rattachement.
  triggeredLineIds     String[]        @default([])
  /// Le stock de l'officine a-t-il pu répondre à ce besoin ? COVERED · NO_SUITABLE
  /// (des références existent mais aucune ne convient) · OUT_OF_STOCK (en rupture)
  /// · NOT_REFERENCED (aucune référence). Vide : besoin écarté par la sécurité, ou
  /// analyse antérieure à cette information. C'est elle qui nourrit « Votre
  /// assortiment » : un besoin réel que le stock n'a pas couvert.
  coverage             String?
  createdAt            DateTime        @default(now())

  analysisRun     AnalysisRun      @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]

  @@index([analysisRunId])
  @@map("advice_opportunities")
}

enum RecommendationOrigin {
  AI
  MANUAL
  RULE
}

enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  MODIFIED
  REPLACED
  REMOVED
  PRESENTED
  PURCHASED
  DECLINED
  /// Proposée, jamais tranchée, et la vente s'est terminée. C'est un résultat à
  /// part entière : sans lui, on ne saurait pas distinguer « refusé » de
  /// « même pas regardé » quand viendra le moment de mesurer la qualité des
  /// recommandations.
  IGNORED
}

model Recommendation {
  id             String  @id @default(cuid())
  pharmacyId     String
  prescriptionId String
  analysisRunId  String?
  opportunityId  String?
  productId      String?
  /// Présentation du catalogue national, quand la recommandation porte sur un
  /// médicament conseil plutôt que sur un produit du catalogue de l'officine.
  /// Les deux liens sont facultatifs et mutuellement exclusifs en pratique.
  presentationId String?

  origin RecommendationOrigin @default(AI)
  status RecommendationStatus @default(PROPOSED)

  /// Détail des dimensions de score (cf. src/core/ai/engines/scoring.ts).
  /// { relevance, safety, availability, patientFit, pharmacistPreference,
  ///   validationHistory, commercial } — chacune 0 → 1.
  scoreBreakdown Json  @default("{}")
  totalScore     Float @default(0)

  /// Justification destinée au pharmacien (technique, traçable).
  justification String
  /// La même chose en une ligne, lisible d'un coup d'œil au comptoir.
  /// La version longue reste pour la relecture a posteriori.
  shortReason   String?
  /// Formulation écrite sur la fiche remise au patient.
  patientReason String?
  /// Le produit à associer, quand la règle de conseil en prévoit un (une
  /// seringue de lavage avec un flacon de sérum physiologique, par exemple) :
  /// { productId, name, salePriceCents, stockQuantity, reason }. Proposé à côté
  /// de la carte, jamais ajouté sans un geste du pharmacien.
  companion     Json?
  /// Les autres références du stock jugées adaptées au MÊME besoin (jusqu'à
  /// trois, dans l'ordre du classement) : { productId, totalScore, shortReason }[].
  /// Elles aident le pharmacien à choisir ; aucune n'est ajoutée sans son geste.
  alternatives  Json?
  /// L'étape d'une routine (nettoyer, hydrater, protéger) quand la
  /// recommandation en fait partie : clé, titre, rang, bénéfice.
  routine       Json?
  /// La phrase réellement affichée au pharmacien pour être dite au patient.
  /// Elle provient du catalogue de règles de conseil, jamais d'une génération
  /// libre. On la conserve avec la recommandation parce que c'est ce qui a été
  /// dit au comptoir : il faut pouvoir le relire des mois plus tard.
  counterScript String?
  precautions   String[] @default([])
  /// Vigilances patient structurées affichées sur la carte (grossesse,
  /// allaitement, asthme, épilepsie, enfant…) : population, niveau, texte,
  /// source. Jamais recopiées dans le document remis au patient.
  vigilances    Json?

  quantity       Int @default(1)
  unitPriceCents Int @default(0)

  decidedByUserId   String?
  decidedAt         DateTime?
  replacedProductId String?
  /// Note libre du pharmacien lors de la modification.
  pharmacistNote    String?

  presentedAt DateTime?
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pharmacy        Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription    Prescription       @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  analysisRun     AnalysisRun?       @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  /// `SetNull` : une présentation retirée du catalogue national ne doit pas
  /// effacer la recommandation qui l'a citée — c'est une trace.
  presentation    DrugPresentation?  @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  opportunity     AdviceOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  product         Product?           @relation("RecommendationProduct", fields: [productId], references: [id], onDelete: SetNull)
  replacedProduct Product?           @relation("RecommendationReplacedProduct", fields: [replacedProductId], references: [id], onDelete: SetNull)
  decidedBy       User?              @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)

  events    RecommendationEvent[]
  saleLines SaleLine[]

  @@index([pharmacyId, createdAt])
  @@index([prescriptionId])
  @@index([pharmacyId, status])
  @@map("recommendations")
}

enum RecommendationEventType {
  GENERATED
  VIEWED
  ACCEPTED
  MODIFIED
  REPLACED
  REMOVED
  MANUALLY_ADDED
  PRESENTED_TO_PATIENT
  PURCHASED
  DECLINED_BY_PATIENT
  /// La vente s'est terminée sans que le pharmacien tranche.
  IGNORED
  /// Refus repris au comptoir : le patient a changé d'avis dans la minute.
  REOPENED
}

/// Journal complet du cycle de vie d'une recommandation : c'est cette table qui
/// permet de reconstituer précisément ce qui s'est passé, et de calculer la
/// conversion à chaque étape.
model RecommendationEvent {
  id               String                  @id @default(cuid())
  recommendationId String
  type             RecommendationEventType
  userId           String?
  metadata         Json                    @default("{}")
  createdAt        DateTime                @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([recommendationId, createdAt])
  @@index([type, createdAt])
  @@map("recommendation_events")
}

enum PharmacyRuleType {
  PREFER_PRODUCT
  EXCLUDE_PRODUCT
  PREFER_CATEGORY
  EXCLUDE_CATEGORY
  /// Un laboratoire ou une marque à mettre en avant (appariement sur le nom).
  PREFER_BRAND
  /// Un laboratoire ou une marque à ne plus proposer.
  EXCLUDE_BRAND
}

/// Préférences de conseil propres à l'officine, alimentées par le retour du
/// pharmacien. Ces règles n'agissent QUE sur l'étape commerciale du pipeline :
/// elles ne peuvent jamais faire remonter une proposition écartée pour raison
/// de sécurité.
model PharmacyRule {
  id              String           @id @default(cuid())
  pharmacyId      String
  type            PharmacyRuleType
  productId       String?
  category        ProductCategory?
  /// Laboratoire ou marque visé par une règle PREFER_BRAND / EXCLUDE_BRAND.
  brand           String?
  /// Contexte d'application : { drugClasses: [...], atcPrefixes: [...] }
  context         Json             @default("{}")
  note            String?
  weight          Float            @default(1)
  isActive        Boolean          @default(true)
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  pharmacy  Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([pharmacyId, isActive])
  @@map("pharmacy_rules")
}

// ===========================================================================
// DOCUMENT PATIENT
// ===========================================================================

model PatientDocument {
  id             String    @id @default(cuid())
  pharmacyId     String
  patientId      String?
  prescriptionId String
  version        Int       @default(1)
  /// Instantané figé du contenu publié (voir src/core/documents/types.ts).
  contentJson    Json
  /// Jeton d'accès à la version numérique. Long, aléatoire, révocable.
  accessToken    String    @unique
  tokenExpiresAt DateTime
  revokedAt      DateTime?

  createdByUserId String?
  printedAt       DateTime?
  viewCount       Int       @default(0)
  lastViewedAt    DateTime?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy     Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  patient      Patient?           @relation(fields: [patientId], references: [id], onDelete: SetNull)
  prescription Prescription       @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  deliveries   DocumentDelivery[]

  @@index([pharmacyId, createdAt])
  @@map("patient_documents")
}

enum DeliveryChannel {
  PRINT
  EMAIL
  SMS
  QR_CODE
  LINK
}

enum DeliveryStatus {
  /// Aucun fournisseur réel n'est branché : l'envoi est explicitement simulé.
  SIMULATED
  PENDING
  SENT
  FAILED
}

/// Un plan de prise remis scellé : chiffré avec une clé que le serveur n'a
/// jamais. Ni patient, ni adresse : seulement l'officine, la vente, et un
/// contenu illisible sans le lien. Effacé à l'échéance (src/core/documents/seal.ts).
model SealedDocument {
  id              String    @id @default(cuid())
  pharmacyId      String
  prescriptionId  String
  version         Int       @default(1)
  ciphertext      Bytes
  iv              Bytes
  tag             Bytes
  expiresAt       DateTime
  revokedAt       DateTime?
  createdByUserId String?
  viewCount       Int       @default(0)
  lastViewedAt    DateTime?
  isDemo          Boolean   @default(false)
  createdAt       DateTime  @default(now())

  pharmacy     Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, createdAt])
  @@index([prescriptionId])
  @@index([expiresAt])
  @@map("sealed_documents")
}

model DocumentDelivery {
  id           String          @id @default(cuid())
  documentId   String
  channel      DeliveryChannel
  status       DeliveryStatus  @default(SIMULATED)
  /// Destinataire masqué dans les journaux (ex. j***@exemple.fr).
  targetMasked String?
  provider     String?
  detail       String?
  userId       String?
  createdAt    DateTime        @default(now())

  document PatientDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_deliveries")
}

// ===========================================================================
// SUIVI PATIENT
// ===========================================================================

enum ReminderReason {
  /// Fin de cure : on reprend contact quand le traitement se termine.
  COURSE_END
  /// Renouvellement d'un traitement chronique.
  RENEWAL
  /// Contrôle de tolérance en début de traitement.
  TOLERANCE_CHECK
  /// Rappel saisonnier adossé à un achat réel.
  SEASONAL
  CUSTOM
}

enum ReminderStatus {
  SCHEDULED
  SENT
  SNOOZED
  CANCELLED
  DONE
}

/// Un suivi patient à envoyer.
///
/// Deux garanties tiennent dans ce modèle. D'abord, un rappel est TOUJOURS
/// adossé à un fait enregistré — une vente, une ordonnance — jamais à un profil
/// déduit ni à un score d'appétence : `saleId` / `prescriptionId` sont la trace
/// de ce fait. Ensuite, rien ne part tout seul : un rappel arrive à échéance
/// dans une liste de travail, et c'est un pharmacien qui l'envoie, ce que
/// `sentByUserId` enregistre.
///
/// Le contenu du message ne vit pas ici : il est produit par un gabarit figé
/// dans le code (src/core/followup/templates.ts), relu et versionné, plutôt que
/// par un champ libre où une justification médicale pourrait être improvisée.
model Reminder {
  id         String @id @default(cuid())
  pharmacyId String
  patientId  String

  /// Le fait générateur. Conservés comme références de traçabilité.
  saleId           String?
  prescriptionId   String?
  recommendationId String?

  reason      ReminderReason
  /// Clé du gabarit de message (cf. src/core/followup/templates.ts).
  templateKey String
  dueAt       DateTime
  status      ReminderStatus @default(SCHEDULED)

  channel        DeliveryChannel @default(EMAIL)
  deliveryStatus DeliveryStatus  @default(SIMULATED)
  /// Destinataire masqué dans les journaux (ex. j***@exemple.fr).
  targetMasked   String?
  provider       String?
  detail         String?

  sentAt          DateTime?
  sentByUserId    String?
  createdByUserId String?
  /// Note interne du pharmacien. Jamais transmise au patient.
  note            String?

  /// Jeton opaque du lien « Comment allez-vous ? » contenu dans le message.
  /// Créé à l'envoi, propre à ce suivi : il ne donne accès à rien d'autre.
  responseToken   String?         @unique
  answer          FollowUpAnswer?
  answeredAt      DateTime?
  /// Le pharmacien a traité la demande de conseil (rappel, passage au comptoir).
  handledAt       DateTime?
  handledByUserId String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, status, dueAt])
  @@index([patientId, dueAt])
  @@map("reminders")
}

// ===========================================================================
// VENTES & ATTRIBUTION DU CHIFFRE D'AFFAIRES
// ===========================================================================

enum SaleChannel {
  COUNTER
  PHARMA_AI_ADVICE
  OTHER
}

model Sale {
  id             String      @id @default(cuid())
  pharmacyId     String
  patientId      String?
  prescriptionId String?
  reference      String
  channel        SaleChannel @default(COUNTER)

  totalCents            Int @default(0)
  totalMarginCents      Int @default(0)
  /// Sous-total attribuable à une recommandation Pharma.ai.
  attributedCents       Int @default(0)
  attributedMarginCents Int @default(0)

  userId    String?
  note      String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  pharmacy     Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  lines        SaleLine[]

  @@unique([pharmacyId, reference])
  @@index([pharmacyId, createdAt])
  @@map("sales")
}

model SaleLine {
  id               String  @id @default(cuid())
  saleId           String
  productId        String?
  /// Renseigné quand la ligne est un médicament conseil du catalogue national
  /// (stock officine `PharmacyDrugStock`), et non un produit de l'officine.
  presentationId   String?
  /// Renseigné lorsque la vente découle d'une recommandation Pharma.ai.
  /// C'est la clé de l'attribution du chiffre d'affaires additionnel.
  recommendationId String?

  label          String
  quantity       Int    @default(1)
  unitPriceCents Int    @default(0)
  totalCents     Int    @default(0)
  marginCents    Int    @default(0)
  vatRate        Float  @default(20)

  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@index([presentationId])
  @@index([recommendationId])
  @@map("sale_lines")
}

// ===========================================================================
// NOTIFICATIONS, AUDIT
// ===========================================================================

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  RECOMMENDATION_PENDING
  ANALYSIS_FAILED
  DOCUMENT_NOT_DELIVERED
  IMPORT_COMPLETED
  IMPORT_FAILED
  FOLLOW_UP_RESPONSE
  TEAM_EVENT
  SYSTEM
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

model Notification {
  id         String               @id @default(cuid())
  pharmacyId String
  /// `null` = destinée à toute l'équipe de l'officine.
  userId     String?
  type       NotificationType
  severity   NotificationSeverity @default(INFO)
  title      String
  body       String
  linkUrl    String?
  metadata   Json                 @default("{}")
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, createdAt])
  @@index([pharmacyId, readAt])
  @@map("notifications")
}

model AuditLog {
  id              String   @id @default(cuid())
  pharmacyId      String?
  userId          String?
  /// Identifiant de l'administrateur plateforme le cas échéant.
  platformAdminId String?
  action          String
  entityType      String
  entityId        String?
  /// Contexte non sensible. Les données de santé n'y figurent jamais en clair.
  metadata        Json     @default("{}")
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pharmacyId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ===========================================================================
// EXTRANET COMMERCIAL — du prospect à l'officine activée
// ===========================================================================

enum SalesCommissionType {
  FIXED
  PERCENT
  RECURRING
}

enum ProspectStatus {
  PROSPECT
  CONTACTED
  DEMO_SCHEDULED
  DEMO_DONE
  INTERESTED
  PROPOSAL_SENT
  CONTRACT_SENT
  CONTRACT_SIGNED
  PHARMACY_CREATED
  ACTIVATED
  LOST
}

enum ProspectOrigin {
  SELF_SERVICE_SITE
  SUPER_ADMIN
  COMMERCIAL
}

enum ContractStatus {
  DRAFT
  SENT
  OPENED
  SIGNED_PHARMACY
  SIGNED_COMPANY
  FINALIZED
  REFUSED
  EXPIRED
}

enum CommissionStatus {
  FORECAST
  EARNED
  PAYABLE
  PAID
  CANCELLED
}

enum ProspectEventType {
  CREATED
  STATUS_CHANGED
  NOTE
  EMAIL_SENT
  CONTRACT_GENERATED
  CONTRACT_SENT
  CONTRACT_OPENED
  CONTRACT_SIGNED
  CONTRACT_REFUSED
  CONTRACT_EXPIRED
  PHARMACY_CREATED
  COMMISSION_CREATED
  COMMISSION_UPDATED
  COMMISSION_PAID
  TASK_CREATED
  TASK_DONE
  ASSIGNED
  BLOCKED
  UNBLOCKED
  SUBSCRIPTION_REQUESTED
  CONTRACT_REMINDER
  SIGNED_PDF_ARCHIVED
  SUBSCRIPTION_PENDING
  DUPLICATE_SUSPECTED
  SIGNATURE_ERROR
}

enum ExtranetAudience {
  SALES
  ADMIN
}

/// Un commercial. Compte de la plateforme, distinct des utilisateurs
/// d'officine : il n'obtient jamais de portée sur une officine et ne peut
/// donc emprunter aucun chemin vers des données patients.
model SalesRep {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  /// Zone commerciale libre : département, région, secteur ou ville.
  zone         String?

  commissionType  SalesCommissionType @default(FIXED)
  /// FIXED et RECURRING : centimes. PERCENT : centièmes de pour cent (1250 = 12,50 %).
  commissionValue Int                 @default(0)

  isActive    Boolean   @default(true)
  invitedAt   DateTime?
  lastLoginAt DateTime?

  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      SalesRepSession[]
  prospects     Prospect[]
  commissions   Commission[]
  tasks         SalesTask[]
  notifications ExtranetNotification[]
  application   SalesApplication?

  @@map("sales_reps")
}

model SalesRepSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  salesRepId String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?

  salesRep SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  @@index([salesRepId])
  @@map("sales_rep_sessions")
}

/// Un dossier commercial : une pharmacie, du premier contact à l'activation.
model Prospect {
  id           String  @id @default(cuid())
  name         String
  ownerName    String?
  phone        String?
  email        String?
  addressLine1 String?
  postalCode   String?
  city         String?
  finessNumber String?
  siret        String?
  outletCount  Int?
  /// Nombre de postes de comptoir déclarés. Distinct de `outletCount`, le nombre de POINTS DE VENTE facturé au contrat.
  postCount    Int?
  /// E-mail de contact de l'officine, distinct de celui du représentant (`email`, signataire et futur identifiant).
  contactEmail String?
  /// Logiciel de gestion déclaré à l'inscription : repris à la création de l'espace.
  lgo          String?
  /// Raison sociale de la société qui exploite l'officine (SELARL…), si elle diffère du nom commercial.
  legalName    String?
  /// Qualité du représentant signataire (« Pharmacien titulaire », « Gérant »…).
  ownerTitle   String?

  /// D'où vient le dossier : le site, la console, ou un commercial.
  origin                  ProspectOrigin @default(COMMERCIAL)
  /// L'officine a explicitement demandé à souscrire : distinct de la simple création du dossier.
  subscriptionRequestedAt DateTime?
  /// Offre choisie (site) ou retenue pour le contrat.
  planId                  String?
  /// Doublon possible repéré à la création : texte lisible, pour l'administrateur.
  duplicateWarning        String?

  /// Le commercial qui suit le dossier. Vide : dossier tenu par la console
  /// (officine créée directement par l'administrateur).
  salesRepId String?
  status     ProspectStatus @default(PROSPECT)

  lastContactAt       DateTime?
  nextActionAt        DateTime?
  nextActionLabel     String?
  /// Démonstration programmée (date et heure), puis réalisée.
  demoAt              DateTime?
  demoDoneAt          DateTime?
  /// Notes commerciales courantes (le détail horodaté vit dans les événements).
  notes               String?
  /// Conditions proposées : abonnement mensuel, en centimes.
  monthlyPriceCents   Int?
  /// Code de parrainage donné à l'inscription, résolu à la création de l'officine.
  /// La formule choisie par le visiteur sur le site : MONTHLY ou ANNUAL. Vide : aucune (dossier créé à la main).
  subscriptionFormula String?
  referralCode        String?

  /// L'officine créée après signature. Un dossier, une officine.
  pharmacyId String? @unique

  blockedAt     DateTime?
  blockedReason String?
  lostReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesRep         SalesRep?            @relation(fields: [salesRepId], references: [id])
  pharmacy         Pharmacy?            @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  plan             Plan?                @relation(fields: [planId], references: [id])
  events           ProspectEvent[]
  contracts        Contract[]
  commissions      Commission[]
  tasks            SalesTask[]
  invitations      PharmacyInvitation[]
  adminNotes       AdminNote[]
  referralLeads    ReferralLead[]       @relation("ReferrerLeads")
  referredFromLead ReferralLead?        @relation("ReferredLead")

  @@index([salesRepId, status])
  @@index([status])
  @@index([siret])
  @@index([demoAt])
  @@map("prospects")
}

/// L'historique d'un dossier : qui, quand, quoi. Jamais modifié, jamais effacé.
model ProspectEvent {
  id         String            @id @default(cuid())
  prospectId String
  type       ProspectEventType
  summary    String
  /// SALES · ADMIN · SYSTEM · SIGNER
  actorType  String
  actorId    String?
  actorLabel String?
  metadata   Json              @default("{}")
  createdAt  DateTime          @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, createdAt])
  @@map("prospect_events")
}

/// Une relance : « appeler vendredi », « renvoyer le contrat ».
model SalesTask {
  id         String    @id @default(cuid())
  prospectId String
  salesRepId String
  label      String
  dueAt      DateTime
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  salesRep SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  @@index([salesRepId, dueAt])
  @@map("sales_tasks")
}

/// Un contrat entre la société exploitante et la pharmacie. Le PDF est stocké
/// via le fournisseur de stockage ; l'accès passe par un jeton dont seule
/// l'empreinte est conservée.
model Contract {
  id              String         @id @default(cuid())
  prospectId      String
  version         Int
  status          ContractStatus @default(DRAFT)
  templateKey     String
  fileKey         String
  accessTokenHash String         @unique

  monthlyPriceCents Int
  durationMonths    Int
  /// L'offre et l'essai contractuels, tels qu'écrits dans le PDF.
  planId            String?
  trialDays         Int     @default(0)
  /// L'officine concernée, quand elle existe déjà au moment du contrat.
  pharmacyId        String?

  pharmacySignerName  String
  pharmacySignerEmail String
  companySignerName   String
  companySignerEmail  String

  /// none · yousign · docusign · … ; « offline » = signature papier enregistrée par l'admin.
  signatureProvider  String    @default("none")
  providerEnvelopeId String?
  /// Lien de signature du titulaire fourni par le prestataire : repris dans les renvois et les relances.
  pharmacySigningUrl String?
  /// Verrou d'envoi : posé le temps de créer la demande de signature, il empêche un double envoi.
  sendLockedAt       DateTime?
  /// Date de prise d'effet inscrite au contrat.
  startDate          DateTime?
  /// PDF signé récupéré chez le prestataire et archivé.
  signedArchivedAt   DateTime?
  /// Relances envoyées au titulaire tant que le contrat n'est pas signé.
  reminderCount      Int       @default(0)
  lastReminderAt     DateTime?
  /// Dossier signalé à l'équipe après les relances.
  escalatedAt        DateTime?
  /// Référence imprimée dans le PDF, figée à la génération.
  reference          String?
  /// Copie des parties telles qu'imprimées au contrat (société exploitante,
  /// officine) : une modification ultérieure de la fiche société ne touche
  /// jamais un contrat déjà généré.
  companySnapshot    Json?
  pharmacySnapshot   Json?

  sentAt           DateTime?
  openedAt         DateTime?
  pharmacySignedAt DateTime?
  companySignedAt  DateTime?
  finalizedAt      DateTime?
  refusedAt        DateTime?
  refusalReason    String?
  expiresAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospect Prospect             @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  plan     Plan?                @relation(fields: [planId], references: [id])
  pharmacy Pharmacy?            @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  invites  SubscriptionInvite[]

  @@index([prospectId])
  @@index([pharmacyId])
  @@index([status])
  @@map("contracts")
}

model Commission {
  id          String              @id @default(cuid())
  prospectId  String
  salesRepId  String
  type        SalesCommissionType
  amountCents Int
  status      CommissionStatus    @default(FORECAST)
  dueAt       DateTime?
  paidAt      DateTime?
  note        String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  salesRep SalesRep @relation(fields: [salesRepId], references: [id])

  @@index([salesRepId, status])
  @@map("commissions")
}

/// Notifications de l'extranet : pour un commercial, ou pour les administrateurs.
model ExtranetNotification {
  id         String               @id @default(cuid())
  audience   ExtranetAudience
  salesRepId String?
  type       String
  severity   NotificationSeverity @default(INFO)
  title      String
  body       String
  linkUrl    String?
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  salesRep SalesRep? @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  @@index([audience, salesRepId, readAt])
  @@map("extranet_notifications")
}

/// Réglages de la plateforme modifiables depuis la console (clé → valeur JSON).
/// Ex. « contract.reminders » : la cadence des relances de contrat.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

/// La société exploitante, partie aux contrats. Une seule ligne.
model CompanyProfile {
  id                  String   @id @default("default")
  legalName           String
  legalForm           String?
  addressLine1        String?
  postalCode          String?
  city                String?
  siren               String?
  representativeName  String
  representativeTitle String?
  representativeEmail String
  updatedAt           DateTime @updatedAt

  @@map("company_profile")
}

/// Une demande spontanée au comptoir : un client sans ordonnance décrit ce
/// qu'il ressent, le moteur propose parmi le stock. Conservée pour que le
/// titulaire voie ce que le comptoir traite, et pour relire a posteriori ce
/// qui a été proposé. Jamais rattachée à un patient identifié.
model CounterRequest {
  id              String   @id @default(cuid())
  pharmacyId      String
  userId          String
  text            String
  ageYears        Int?
  isPregnant      Boolean?
  isBreastfeeding Boolean?
  treatments      String[] @default([])
  /// Les besoins retenus : { key, justification, confidence }[].
  needs           Json     @default("[]")
  questions       String[] @default([])
  referToDoctor   Boolean  @default(false)
  referReason     String?
  summary         String?
  /// Les propositions telles qu'affichées : produit, prix, raison, phrase.
  proposals       Json     @default("[]")
  proposalCount   Int      @default(0)
  providerId      String
  model           String?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, createdAt])
  @@map("counter_requests")
}

/// Invitation d'un titulaire à compléter lui-même le dossier de son officine.
/// Le lien porte un jeton dont seule l'empreinte est conservée ; un renvoi en
/// émet un nouveau et rend le précédent inutilisable.
model PharmacyInvitation {
  id               String    @id @default(cuid())
  prospectId       String
  email            String
  tokenHash        String    @unique
  expiresAt        DateTime
  sentAt           DateTime?
  sendCount        Int       @default(0)
  lastSendStatus   String?
  lastSendDetail   String?
  openedAt         DateTime?
  completedAt      DateTime?
  revokedAt        DateTime?
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
  @@index([email])
  @@map("pharmacy_invitations")
}

/// Historique du nombre de postes d'une officine : qui l'a changé, quand, de combien à combien.
model PharmacyPostCountChange {
  id         String   @id @default(cuid())
  pharmacyId String
  previous   Int?
  next       Int
  actorType  String
  actorLabel String
  createdAt  DateTime @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, createdAt])
  @@map("pharmacy_post_count_changes")
}

/// Trace de chaque e-mail transactionnel d'inscription et d'accès : remis au
/// prestataire, puis délivré ou rejeté quand le prestataire le signale (webhook).
model EmailDispatch {
  id                String    @id @default(cuid())
  kind              String
  recipient         String
  provider          String?
  providerMessageId String?   @unique
  status            String
  detail            String?
  prospectId        String?
  pharmacyId        String?
  userId            String?
  invitationId      String?
  /// Objet de l'e-mail, et modèle utilisé s'il vient du centre de modèles.
  subject           String?
  templateKey       String?
  /// AUTOMATIC (scénario) · MANUAL (console) · TEST · SYSTEM (transactionnel)
  trigger           String?
  /// La règle d'automatisation à l'origine de l'envoi.
  ruleKey           String?
  contractId        String?
  organizationId    String?
  sentByAdminId     String?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([prospectId, createdAt])
  @@index([pharmacyId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([ruleKey, createdAt])
  @@map("email_dispatches")
}

// ---------------------------------------------------------------------------
// Gammes privilégiées, challenges laboratoires, dates courtes, vigilances
// produit, formation (octobre 2026). Tout est propre à une officine
// (pharmacyId), sauf les formations publiées par PharmaBoost pour toutes
// (pharmacyId vide). Rien de commercial n'entre dans le score clinique : les
// gammes et les dates courtes ne servent qu'au départage de références
// également pertinentes et sûres ; les challenges n'entrent pas dans le moteur.
// ---------------------------------------------------------------------------

/// Une gamme ou un laboratoire travaillé en priorité dans un univers.
model PreferredRange {
  id              String   @id @default(cuid())
  pharmacyId      String
  /// Clé d'univers (src/config/universes.ts) : du texte, pour ajouter un univers sans migration.
  universe        String
  laboratory      String
  /// Marque normalisée (src/core/catalog/brand.ts) : ce qui relie la gamme aux produits.
  brandKey        String
  rangeName       String?
  isActive        Boolean  @default(true)
  /// 1 = la plus prioritaire de l'univers.
  priority        Int      @default(1)
  /// Remise ou marge négociée, en %, quand l'officine la connaît.
  discountPercent Decimal? @db.Decimal(5, 2)
  notes           String?
  /// Produits concernés (Product.id de l'officine). Vide : toute la marque.
  productIds      String[] @default([])
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, universe])
  @@index([pharmacyId, brandKey])
  @@map("preferred_ranges")
}

enum LabChallengeStatus {
  ACTIVE
  ENDED
  ARCHIVED
}

enum LabChallengeCountMode {
  /// Toutes les ventes enregistrées des produits concernés.
  ALL_SALES
  /// Seulement les ventes issues d'un conseil PharmaBoost.
  ATTRIBUTED
}

/// Un challenge commercial proposé par un laboratoire. Hors du moteur de conseil.
model LabChallenge {
  id                String                @id @default(cuid())
  pharmacyId        String
  title             String
  laboratory        String
  brandKey          String?
  universe          String?
  /// Produits concernés (Product.id). Vide : toute la marque (brandKey).
  productIds        String[]              @default([])
  startsAt          DateTime              @db.Date
  endsAt            DateTime              @db.Date
  targetUnits       Int?
  bonusPerUnitCents Int?
  /// Paliers : [{ units, bonusCents }].
  tiers             Json?
  status            LabChallengeStatus    @default(ACTIVE)
  countMode         LabChallengeCountMode @default(ALL_SALES)
  /// D'où viennent les chiffres : PHARMABOOST (ventes enregistrées + saisies).
  /// Un connecteur partenaire (Opeaz…) pourra plus tard en fournir d'autres.
  dataSource        String                @default("PHARMABOOST")
  externalRef       String?
  notes             String?
  createdByUserId   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  pharmacy Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  entries  LabChallengeEntry[]

  @@index([pharmacyId, status])
  @@map("lab_challenges")
}

/// Unités ajoutées à la main (ventes hors PharmaBoost, relevé du laboratoire).
model LabChallengeEntry {
  id              String   @id @default(cuid())
  challengeId     String
  pharmacyId      String
  units           Int
  occurredOn      DateTime @db.Date
  note            String?
  source          String   @default("MANUAL")
  createdByUserId String?
  createdAt       DateTime @default(now())

  challenge LabChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([pharmacyId])
  @@map("lab_challenge_entries")
}

enum StockLotSource {
  MANUAL
  IMPORT
  SCAN
}

/// Un lot et sa date de péremption. Couche à part : la quantité du logiciel de
/// gestion reste la référence du stock, un lot ne la modifie jamais.
model StockLot {
  id              String         @id @default(cuid())
  pharmacyId      String
  productId       String?
  /// Médicament du stock (DrugPresentation.id), quand ce n'est pas un produit du catalogue.
  presentationId  String?
  /// Nom figé à la saisie, pour l'affichage.
  label           String
  lotNumber       String?
  expiresOn       DateTime       @db.Date
  /// DAY ou MONTH : beaucoup de boîtes ne portent que MM/AAAA.
  expiryPrecision String         @default("DAY")
  quantity        Int?
  source          StockLotSource @default(MANUAL)
  importJobId     String?
  note            String?
  /// Lot sorti du suivi (vendu, retourné, détruit) : il ne compte plus.
  resolvedAt      DateTime?
  resolution      String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, expiresOn])
  @@index([productId])
  @@index([presentationId])
  @@map("stock_lots")
}

enum VigilanceLevel {
  INFO
  CAUTION
  CONTRAINDICATION
  PHARMACIST_VALIDATION
}

/// Vigilance déclarée par l'officine sur l'un de ses produits (source : le pharmacien).
model ProductVigilance {
  id              String         @id @default(cuid())
  pharmacyId      String
  productId       String
  /// Population (src/config/vigilances.ts) : PREGNANCY, BREASTFEEDING, ASTHMA, EPILEPSY, CHILD…
  population      String
  level           VigilanceLevel
  note            String?
  source          String         @default("PHARMACIST")
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, population])
  @@index([pharmacyId])
  @@map("product_vigilances")
}

enum TrainingKind {
  VIDEO
  SHEET
  DOCUMENT
  EXTERNAL_LINK
  QUIZ
}

enum TrainingStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// Un contenu de formation : lien officiel, vidéo, fiche courte ou document
/// fourni ou autorisé par son auteur. Vide pharmacyId : publié pour toutes les officines.
model TrainingContent {
  id               String       @id @default(cuid())
  pharmacyId       String?
  title            String
  summary          String?
  kind             TrainingKind
  url              String?
  body             String?
  laboratory       String?
  brandKey         String?
  rangeName        String?
  universe         String?
  /// Codes produit (CIP13/EAN) : un contenu global ne connaît pas les fiches d'une officine.
  productCodes     String[]     @default([])
  /// Produits de l'officine (contenus propres à une officine).
  productIds       String[]     @default([])
  durationMinutes  Int?
  /// Provenance affichée : « Lien officiel du laboratoire », « Contenu fourni par … ».
  sourceLabel      String?
  isActive         Boolean      @default(true)
  createdByAdminId String?
  createdByUserId  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  pharmacy Pharmacy?          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  progress TrainingProgress[]

  @@index([pharmacyId, isActive])
  @@index([brandKey])
  @@map("training_contents")
}

/// La progression d'un membre de l'équipe sur un contenu, dans une officine.
model TrainingProgress {
  id              String         @id @default(cuid())
  contentId       String
  userId          String
  pharmacyId      String
  status          TrainingStatus @default(IN_PROGRESS)
  progressPercent Int            @default(0)
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  updatedAt       DateTime       @updatedAt

  content TrainingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, userId, pharmacyId])
  @@index([pharmacyId, userId])
  @@map("training_progress")
}

// ---------------------------------------------------------------------------
// PharmaBoost Partenaires (octobre 2026). Des laboratoires et marques
// référencent leurs gammes ; les officines éligibles les découvrent, peuvent
// les masquer, contacter la marque ou commander quand l'intégration le
// permet ; PharmaBoost attribue leads et commandes. Données centrales, jamais
// dupliquées par officine. AUCUNE donnée patient ni d'ordonnance dans ces
// tables, et rien ici n'est lu par le moteur de conseil.
// ---------------------------------------------------------------------------

/// Cycle de publication central : une marque ACTIVE est disponible pour les officines éligibles.
enum PartnerPublicationStatus {
  DRAFT
  TEST
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// À qui une marque est diffusée. En statut TEST, seul le groupe pilote la voit, quel que soit ce choix.
enum PartnerAudience {
  ALL_PHARMACIES
  SELECTED_PHARMACIES
  PILOT_GROUP
}

/// Masquée : absente du comptoir, toujours consultable au catalogue. Refusée : absente partout.
enum PartnerPreferenceChoice {
  HIDDEN
  REFUSED
}

enum PartnerApplicationStatus {
  NEW
  REVIEWING
  CONTACTED
  NEGOTIATION
  ACCEPTED
  REFUSED
  ACTIVE_PARTNER
}

enum PartnerAnswer {
  YES
  NO
  UNKNOWN
}

/// Comment une commande ou une prise de contact parvient au partenaire.
enum PartnerIntegrationMode {
  API
  B2B_LINK
  FORM
  EMAIL
  IMPORT_EXPORT
  MANUAL
}

enum PartnerContractType {
  FLAT_FEE
  COMMISSION
  HYBRID
  PILOT
  FREE
}

enum PartnerOrderStatus {
  SUBMITTED
  TRANSMITTED
  CONFIRMED
  FAILED
  CANCELLED
}

enum PartnerLeadKind {
  CONTACT_REQUEST
  B2B_LINK_OPENED
  FORM_OPENED
}

enum PartnerAttributionKind {
  VIEW
  LEAD
  ORDER
}

enum PartnerAttributionSource {
  COUNTER_CARD
  CATALOG
  BRAND_PAGE
}

/// Candidature déposée sur le site public. Aucune activation automatique.
model PartnerApplication {
  id               String                   @id @default(cuid())
  status           PartnerApplicationStatus @default(NEW)
  company          String
  brand            String
  contactFirstName String
  contactLastName  String
  contactRole      String?
  email            String
  phone            String?
  website          String?
  universes        String[]                 @default([])
  approxReferences Int?
  distribution     String?
  hasApi           PartnerAnswer            @default(UNKNOWN)
  hasB2bPortal     Boolean?
  hasCatalog       Boolean?
  hasTrainings     Boolean?
  message          String?
  consentAt        DateTime
  /// Le partenaire créé à partir de cette candidature, une fois acceptée.
  partnerId        String?
  acknowledgedAt   DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  partner Partner?                  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  events  PartnerApplicationEvent[]

  @@index([status, createdAt])
  @@map("partner_applications")
}

/// Historique d'une candidature : changements de statut et notes internes.
model PartnerApplicationEvent {
  id              String                    @id @default(cuid())
  applicationId   String
  kind            String
  fromStatus      PartnerApplicationStatus?
  toStatus        PartnerApplicationStatus?
  note            String?
  platformAdminId String?
  createdAt       DateTime                  @default(now())

  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("partner_application_events")
}

/// Le laboratoire ou la société partenaire.
model Partner {
  id               String                   @id @default(cuid())
  name             String
  slug             String                   @unique
  legalName        String?
  website          String?
  logoUrl          String?
  description      String?
  universes        String[]                 @default([])
  status           PartnerPublicationStatus @default(DRAFT)
  startsAt         DateTime?
  endsAt           DateTime?
  /// Notes internes PharmaBoost, jamais montrées aux officines.
  notes            String?
  createdByAdminId String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  contacts     PartnerContact[]
  brands       PartnerBrand[]
  offers       PartnerOffer[]
  integrations PartnerIntegration[]
  contracts    PartnerContract[]
  applications PartnerApplication[]
  attributions PartnerAttribution[]
  leads        PartnerLead[]
  orders       PartnerOrder[]

  @@index([status])
  @@map("partners")
}

model PartnerContact {
  id             String   @id @default(cuid())
  partnerId      String
  firstName      String
  lastName       String
  role           String?
  email          String?
  phone          String?
  isPrimary      Boolean  @default(false)
  /// Reçoit les commandes et prises de contact transmises par e-mail.
  receivesOrders Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_contacts")
}

/// Une marque d'un partenaire, publiée de façon centrale.
model PartnerBrand {
  id               String                   @id @default(cuid())
  partnerId        String
  name             String
  slug             String                   @unique
  /// Marque normalisée (src/core/catalog/brand.ts) : relie la marque au stock et aux formations.
  brandKey         String
  logoUrl          String?
  description      String?
  universes        String[]                 @default([])
  status           PartnerPublicationStatus @default(DRAFT)
  audience         PartnerAudience          @default(ALL_PHARMACIES)
  /// Critères futurs (zones, typologies…), non interprétés aujourd'hui.
  audienceCriteria Json?
  publishedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  partner     Partner                     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  ranges      PartnerRange[]
  products    PartnerProduct[]
  documents   PartnerDocument[]
  offers      PartnerOffer[]
  audiences   PartnerBrandAudience[]
  preferences PharmacyPartnerPreference[]

  @@index([partnerId])
  @@index([status])
  @@index([brandKey])
  @@map("partner_brands")
}

/// Une gamme d'une marque.
model PartnerRange {
  id          String                   @id @default(cuid())
  brandId     String
  name        String
  description String?
  universe    String?
  status      PartnerPublicationStatus @default(DRAFT)
  sortOrder   Int                      @default(0)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  brand    PartnerBrand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products PartnerProduct[]
  offers   PartnerOffer[]

  @@index([brandId])
  @@map("partner_ranges")
}

/// Un produit du catalogue partenaire (central, jamais copié dans les officines).
model PartnerProduct {
  id               String   @id @default(cuid())
  brandId          String
  rangeId          String?
  name             String
  ean              String?
  cip13            String?
  description      String?
  imageUrl         String?
  packaging        String?
  proPriceCents    Int?
  publicPriceCents Int?
  externalRef      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  brand PartnerBrand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  range PartnerRange? @relation(fields: [rangeId], references: [id], onDelete: SetNull)

  @@index([brandId])
  @@index([rangeId])
  @@index([ean])
  @@map("partner_products")
}

/// Documentation professionnelle d'une marque (lien vers la source).
model PartnerDocument {
  id        String   @id @default(cuid())
  brandId   String
  title     String
  kind      String   @default("DOCUMENT")
  url       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  brand PartnerBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@map("partner_documents")
}

/// Conditions professionnelles proposées aux officines.
model PartnerOffer {
  id                String                   @id @default(cuid())
  partnerId         String
  brandId           String?
  rangeId           String?
  title             String
  conditions        String
  discountPercent   Decimal?                 @db.Decimal(5, 2)
  minimumOrderCents Int?
  validFrom         DateTime?
  validTo           DateTime?
  status            PartnerPublicationStatus @default(DRAFT)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  partner Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  brand   PartnerBrand? @relation(fields: [brandId], references: [id], onDelete: Cascade)
  range   PartnerRange? @relation(fields: [rangeId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([brandId])
  @@map("partner_offers")
}

/// Mode d'intégration d'un partenaire. Aucun secret ici : une clé d'API vivra
/// dans le coffre de secrets, jamais en base.
model PartnerIntegration {
  id             String                 @id @default(cuid())
  partnerId      String
  mode           PartnerIntegrationMode
  isActive       Boolean                @default(false)
  /// Lien du portail B2B, avec {code} remplacé par l'identifiant d'attribution.
  b2bUrlTemplate String?
  orderEmail     String?
  formUrl        String?
  /// Capacités annoncées : CATALOG, AVAILABILITY, PRO_PRICE, ORDER_CREATE, ORDER_STATUS, ATTRIBUTION.
  capabilities   String[]               @default([])
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_integrations")
}

/// Contrat partenaire : strictement interne à PharmaBoost. Aucune facturation automatique.
model PartnerContract {
  id                     String              @id @default(cuid())
  partnerId              String
  type                   PartnerContractType
  startsAt               DateTime?
  endsAt                 DateTime?
  fixedAmountCents       Int?
  commissionPercent      Decimal?            @db.Decimal(5, 2)
  commissionPerUnitCents Int?
  minimumCents           Int?
  notes                  String?
  createdByAdminId       String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_contracts")
}

/// Officines retenues pour une marque diffusée à une sélection.
model PartnerBrandAudience {
  id         String   @id @default(cuid())
  brandId    String
  pharmacyId String
  createdAt  DateTime @default(now())

  brand    PartnerBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([brandId, pharmacyId])
  @@map("partner_brand_audiences")
}

/// Une officine masque ou refuse une marque partenaire.
model PharmacyPartnerPreference {
  id         String                  @id @default(cuid())
  pharmacyId String
  brandId    String
  choice     PartnerPreferenceChoice @default(HIDDEN)
  reason     String?
  userId     String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  pharmacy Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  brand    PartnerBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, brandId])
  @@map("pharmacy_partner_preferences")
}

/// Identifiant d'attribution PharmaBoost : ce qui prouve qu'une consultation,
/// une prise de contact ou une commande vient de PharmaBoost. Jamais de patient.
model PartnerAttribution {
  id         String                   @id @default(cuid())
  code       String                   @unique
  kind       PartnerAttributionKind
  source     PartnerAttributionSource
  partnerId  String
  brandId    String?
  rangeId    String?
  pharmacyId String
  userId     String?
  /// Univers du conseil qui a fait apparaître la carte : jamais le patient ni l'ordonnance.
  universe   String?
  createdAt  DateTime                 @default(now())

  partner  Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  lead     PartnerLead?
  order    PartnerOrder?

  @@index([partnerId, createdAt])
  @@index([pharmacyId, createdAt])
  @@map("partner_attributions")
}

model PartnerLead {
  id              String          @id @default(cuid())
  attributionId   String          @unique
  partnerId       String
  brandId         String?
  pharmacyId      String
  kind            PartnerLeadKind
  /// NEW → TRANSMITTED → CLOSED.
  message         String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  status          String          @default("NEW")
  transmittedAt   DateTime?
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  attribution PartnerAttribution @relation(fields: [attributionId], references: [id], onDelete: Cascade)
  partner     Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  pharmacy    Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([pharmacyId, createdAt])
  @@map("partner_leads")
}

model PartnerOrder {
  id               String                 @id @default(cuid())
  attributionId    String                 @unique
  partnerId        String
  brandId          String
  pharmacyId       String
  integrationMode  PartnerIntegrationMode
  status           PartnerOrderStatus     @default(SUBMITTED)
  totalCents       Int?
  partnerReference String?
  statusDetail     String?
  /// Note libre de l'officine pour le partenaire (jamais de donnée patient).
  note             String?
  transmittedAt    DateTime?
  confirmedAt      DateTime?
  createdByUserId  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  attribution PartnerAttribution @relation(fields: [attributionId], references: [id], onDelete: Cascade)
  partner     Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  pharmacy    Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  lines       PartnerOrderLine[]

  @@index([partnerId, createdAt])
  @@index([pharmacyId, createdAt])
  @@map("partner_orders")
}

model PartnerOrderLine {
  id               String  @id @default(cuid())
  orderId          String
  partnerProductId String?
  name             String
  ean              String?
  quantity         Int
  unitPriceCents   Int?

  order PartnerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("partner_order_lines")
}

// ===========================================================================
// Centre de contrôle Super Admin
// ===========================================================================

/// Un changement de tarif contractuel d'un abonnement existant : toujours
/// explicite, motivé et tracé. Le catalogue (`Plan`) n'en crée jamais.
model SubscriptionPriceChange {
  id               String   @id @default(cuid())
  subscriptionId   String
  organizationId   String
  previousCents    Int?
  nextCents        Int
  reason           String
  /// L'abonnement Stripe a été mis à jour ; sinon, seule la fiche a changé.
  appliedToStripe  Boolean  @default(false)
  effectiveAt      DateTime @default(now())
  changedByAdminId String?
  createdAt        DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_price_changes")
}

/// Note interne de l'équipe PharmaBoost sur une officine ou un dossier.
/// Jamais visible de l'officine ni des commerciaux.
model AdminNote {
  id            String   @id @default(cuid())
  pharmacyId    String?
  prospectId    String?
  body          String
  pinned        Boolean  @default(false)
  authorAdminId String
  authorLabel   String
  createdAt     DateTime @default(now())

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prospect Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, createdAt])
  @@index([prospectId, createdAt])
  @@map("admin_notes")
}

enum CancellationStatus {
  RECEIVED
  IN_PROGRESS
  CONFIRMED
  CANCELED
  COMPLETED
}

/// Une demande de résiliation : reçue, traitée, confirmée ou annulée, puis
/// terminée. Rien n'est jamais supprimé : l'historique reste.
model CancellationRequest {
  id               String             @id @default(cuid())
  pharmacyId       String
  organizationId   String
  subscriptionId   String?
  status           CancellationStatus @default(RECEIVED)
  /// PRICE · NOT_USED · MISSING_FEATURE · CLOSURE · COMPETITOR · TECHNICAL · OTHER
  reason           String
  reasonDetail     String?
  /// EMAIL · PHONE · MAIL · MEETING · OTHER
  channel          String
  requestedAt      DateTime
  plannedEndAt     DateTime?
  confirmedAt      DateTime?
  completedAt      DateTime?
  canceledAt       DateTime?
  lastContactAt    DateTime?
  /// La fin a été programmée chez Stripe (résiliation à la fin de la période).
  stripeScheduled  Boolean            @default(false)
  createdByAdminId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  pharmacy     Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  subscription Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  events       CancellationEvent[]

  @@index([status])
  @@index([pharmacyId, createdAt])
  @@map("cancellation_requests")
}

model CancellationEvent {
  id           String   @id @default(cuid())
  requestId    String
  /// CREATED · STATUS_CHANGED · NOTE · CONTACT · STRIPE_SCHEDULED · EMAIL_SENT
  type         String
  summary      String
  fromStatus   String?
  toStatus     String?
  actorAdminId String?
  actorLabel   String?
  createdAt    DateTime @default(now())

  request CancellationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("cancellation_events")
}

/// Le texte d'un modèle d'e-mail, modifié par l'équipe. Sans ligne : le texte
/// par défaut, écrit dans le code (`src/core/admin/email-templates.ts`).
model EmailTemplate {
  key              String   @id
  subject          String
  title            String
  body             String
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("email_templates")
}

/// Le réglage d'une règle d'automatisation. Sans ligne : la règle est
/// désactivée, avec son délai par défaut. Rien ne part tant qu'un
/// administrateur ne l'a pas activée.
model AutomationRule {
  key              String   @id
  enabled          Boolean  @default(false)
  /// Délai en jours : après l'événement déclencheur, ou avant l'échéance.
  offsetDays       Int
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt

  @@map("automation_rules")
}

/// Chaque déclenchement d'une règle, une seule fois par cible et par
/// occurrence : la clé unique interdit toute relance en double, même si deux
/// passages se chevauchent.
model AutomationDispatch {
  id              String   @id @default(cuid())
  ruleKey         String
  dedupeKey       String   @unique
  /// Subscription · Contract · CancellationRequest · Prospect
  targetType      String
  targetId        String
  pharmacyId      String?
  /// SENT · FAILED · SIMULATED · INTERNAL · SKIPPED
  status          String
  recipient       String?
  detail          String?
  emailDispatchId String?
  createdAt       DateTime @default(now())

  @@index([ruleKey, createdAt])
  @@index([pharmacyId, createdAt])
  @@map("automation_dispatches")
}

// ===========================================================================
// NOTIFICATIONS ET CAMPAGNES (octobre 2026) — additif
//
// 1. Les nouveautés d'une officine pour les patients qui l'ont demandé : le
//    patient s'abonne lui-même, depuis le lien de l'e-mail du plan. Rien
//    n'est conservé sans son geste. AUCUNE donnée de santé ici : ni
//    ordonnance, ni traitement, ni lien avec un plan.
// 2. Les campagnes de la console (offre bonus, parrainage, invitation des
//    partenaires) et la liste de désinscription des offres.
// 3. Les offres de parrainage appliquées aux nouveaux filleuls.
// ===========================================================================

enum PatientNewsStatus {
  ACTIVE
  UNSUBSCRIBED
}

/// L'abonnement d'un patient aux nouveautés de SON officine. Une seule
/// officine par ligne : jamais partagé. L'adresse est chiffrée ; la
/// désinscription l'efface et ne garde que l'empreinte et les dates.
model PatientNewsSubscription {
  id             String            @id @default(cuid())
  pharmacyId     String
  /// Empreinte HMAC de l'adresse : unicité et retrouvailles sans la lire.
  emailHash      String
  /// L'adresse chiffrée (AES-256-GCM, DATA_ENCRYPTION_KEY). Effacée à la désinscription.
  emailCipher    String?
  /// Forme masquée pour l'écran (j***@exemple.fr). Effacée à la désinscription.
  emailMasked    String?
  status         PatientNewsStatus @default(ACTIVE)
  /// D'où vient le consentement : PLAN_EMAIL (lien de l'e-mail du plan).
  consentSource  String            @default("PLAN_EMAIL")
  consentAt      DateTime
  /// Version du texte d'information présenté au patient.
  noticeVersion  String            @default("v1")
  unsubscribedAt DateTime?
  lastNewsAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  pharmacy   Pharmacy              @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  deliveries PatientNewsDelivery[]

  @@unique([pharmacyId, emailHash])
  @@index([pharmacyId, status])
  @@index([consentAt])
  @@map("patient_news_subscriptions")
}

/// Une annonce de l'officine à ses abonnés (« une nouvelle gamme est arrivée »).
model PatientNewsAnnouncement {
  id              String    @id @default(cuid())
  pharmacyId      String
  /// L'objet de l'e-mail.
  title           String
  /// La marque ou la gamme annoncée, en texte libre.
  rangeLabel      String?
  message         String
  /// SENDING · SENT · PARTIAL · FAILED
  status          String    @default("SENDING")
  recipientCount  Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  /// Envoyée sans messagerie configurée : les envois ont été simulés.
  simulated       Boolean   @default(false)
  createdByUserId String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  pharmacy   Pharmacy              @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  deliveries PatientNewsDelivery[]

  @@index([pharmacyId, createdAt])
  @@map("patient_news_announcements")
}

/// L'envoi d'une annonce à un abonné. La clé unique (annonce, abonné) est
/// inscrite AVANT l'envoi : jamais deux e-mails pour la même annonce.
model PatientNewsDelivery {
  id             String   @id @default(cuid())
  announcementId String
  subscriptionId String
  /// CLAIMED · SENT · FAILED · SIMULATED
  status         String   @default("CLAIMED")
  detail         String?
  createdAt      DateTime @default(now())

  announcement PatientNewsAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  subscription PatientNewsSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([announcementId, subscriptionId])
  @@index([subscriptionId])
  @@map("patient_news_deliveries")
}

enum CampaignKind {
  BONUS_OFFER
  REFERRAL_OFFER
  PARTNER_INVITATION
  ANNOUNCEMENT
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELED
}

/// Une campagne de la console : un message, des destinataires, éventuellement
/// une offre chiffrée. Rien ne part sans un envoi confirmé ; le brouillon ne
/// contacte personne.
model Campaign {
  id               String         @id @default(cuid())
  kind             CampaignKind
  /// Nom interne, visible dans la console seulement.
  name             String
  status           CampaignStatus @default(DRAFT)
  subject          String
  title            String
  body             String
  buttonLabel      String?
  /// Où mène le bouton : une clé (espace, parrainage, candidature), jamais une adresse libre.
  buttonTarget     String?
  /// Le segment de destinataires (clé de src/core/admin/campaigns.ts).
  audience         String
  /// Paramètres du segment : identifiants choisis à la main.
  audienceParams   Json           @default("{}")
  /// Aussi une notification dans l'application des officines destinataires.
  alsoInApp        Boolean        @default(false)
  offerAmountCents Int?
  offerEndsAt      DateTime?
  offerConditions  String?
  /// Date d'envoi programmée : l'envoi part au passage quotidien de ce jour-là.
  scheduledFor     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  canceledAt       DateTime?
  recipientCount   Int            @default(0)
  sentCount        Int            @default(0)
  failedCount      Int            @default(0)
  skippedCount     Int            @default(0)
  /// Envoyée sans messagerie configurée : les envois ont été simulés.
  simulated        Boolean        @default(false)
  createdByAdminId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  recipients    CampaignRecipient[]
  referralOffer ReferralOffer?

  @@index([status, scheduledFor])
  @@index([createdAt])
  @@map("campaigns")
}

/// Un destinataire d'une campagne, figé au démarrage de l'envoi. Un seul
/// message par adresse et par campagne (clé unique).
model CampaignRecipient {
  id              String    @id @default(cuid())
  campaignId      String
  /// PHARMACY · PARTNER_CONTACT · PARTNER_APPLICATION
  targetType      String
  targetId        String
  pharmacyId      String?
  partnerId       String?
  /// L'adresse en minuscules : la clé du dédoublonnage.
  emailKey        String
  email           String
  name            String?
  /// PENDING · SENDING · SENT · FAILED · SIMULATED · SKIPPED
  status          String    @default("PENDING")
  /// Le motif d'une exclusion (désinscrit, sans adresse) ou d'un échec.
  detail          String?
  emailDispatchId String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, emailKey])
  @@index([campaignId, status])
  @@index([pharmacyId])
  @@map("campaign_recipients")
}

/// Les adresses professionnelles qui ne veulent plus recevoir d'offres de
/// PharmaBoost. Une campagne ne leur écrit jamais. On ne garde que l'empreinte.
model MarketingOptOut {
  id          String   @id @default(cuid())
  emailHash   String   @unique
  emailMasked String?
  /// LINK (lien du message) · ADMIN (saisi dans la console)
  source      String   @default("LINK")
  campaignId  String?
  createdAt   DateTime @default(now())

  @@map("marketing_opt_outs")
}

/// Une offre de parrainage : pendant sa durée, un filleul inscrit apporte à
/// son parrain ce montant par mois (au lieu du montant standard), figé sur sa
/// fiche (`Pharmacy.referralAmountCents`). Les filleuls déjà inscrits
/// gardent leur montant.
model ReferralOffer {
  id               String    @id @default(cuid())
  label            String
  /// Remise mensuelle par filleul actif, en centimes.
  amountCents      Int
  startsAt         DateTime
  endsAt           DateTime?
  canceledAt       DateTime?
  campaignId       String?   @unique
  createdByAdminId String?
  createdAt        DateTime  @default(now())

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([startsAt, endsAt])
  @@map("referral_offers")
}

// ===========================================================================
// CANDIDATURES COMMERCIALES (octobre 2026) — additif
// Le formulaire public « Rejoindre l'équipe commerciale ». Rien n'est créé
// automatiquement : une candidature acceptée peut devenir un commercial par un
// geste de l'administrateur.
// ===========================================================================

enum SalesApplicationStatus {
  NEW
  TO_CONTACT
  INTERVIEW
  ACCEPTED
  REFUSED
}

model SalesApplication {
  id               String                 @id @default(cuid())
  status           SalesApplicationStatus @default(NEW)
  firstName        String
  lastName         String
  email            String
  phone            String
  /// Ville ou secteur géographique de la personne.
  city             String
  /// L'expérience commerciale, dite par la personne.
  salesExperience  String
  /// L'expérience avec les pharmacies ou la santé : facultative.
  healthExperience String?
  /// Statut actuel : SALARIED · FREELANCE · JOB_SEEKING · STUDENT · OTHER.
  currentStatus    String
  /// La zone dans laquelle la personne souhaite travailler.
  zone             String
  message          String
  consentAt        DateTime
  /// Le CV déposé (PDF), dans le stockage de la plateforme ; vide si aucun.
  cvKey            String?
  cvFileName       String?
  cvSizeBytes      Int?
  /// Le commercial créé à partir de cette candidature, une fois acceptée.
  salesRepId       String?                @unique
  acknowledgedAt   DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  salesRep SalesRep?               @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  events   SalesApplicationEvent[]

  @@index([status, createdAt])
  @@index([email])
  @@map("sales_applications")
}

/// L'historique d'une candidature : changements de statut, notes internes, création du commercial.
model SalesApplicationEvent {
  id              String                  @id @default(cuid())
  applicationId   String
  /// CREATED · STATUS_CHANGED · NOTE · CONVERTED
  kind            String
  fromStatus      SalesApplicationStatus?
  toStatus        SalesApplicationStatus?
  note            String?
  platformAdminId String?
  createdAt       DateTime                @default(now())

  application SalesApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("sales_application_events")
}

// ===========================================================================
// PARRAINAGE : LES CONFRÈRES PROPOSÉS À L'INSCRIPTION (octobre 2026) — additif
// À l'inscription, une officine peut indiquer une personne à parrainer (e-mail,
// téléphone). Rien n'est envoyé à cette personne : l'équipe la contacte. Si elle
// s'abonne, l'officine qui parraine passe à 20 % de moins par mois.
// ===========================================================================

model ReferralLead {
  id                 String   @id @default(cuid())
  /// Le dossier de l'officine qui parraine.
  referrerProspectId String
  contactName        String?
  email              String
  phone              String
  /// NEW · CONTACTED · LINKED (la personne a ouvert son propre dossier) · DECLINED
  status             String   @default("NEW")
  /// Le dossier ouvert par la personne parrainée, rapproché par son e-mail.
  referredProspectId String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  referrerProspect Prospect  @relation("ReferrerLeads", fields: [referrerProspectId], references: [id], onDelete: Cascade)
  referredProspect Prospect? @relation("ReferredLead", fields: [referredProspectId], references: [id], onDelete: SetNull)

  @@index([referrerProspectId])
  @@index([email])
  @@map("referral_leads")
}

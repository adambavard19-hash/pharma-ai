# ---------------------------------------------------------------------------
# Pharma.ai — production sur pharmaboost.app
# Copier en `.env.production` sur le serveur. NE JAMAIS committer ce fichier.
# ---------------------------------------------------------------------------

# Mot de passe de la base PostgreSQL du docker-compose (générer : openssl rand -hex 24)
POSTGRES_PASSWORD=""

# Adresse publique : celle du QR code, des e-mails et des liens patients.
APP_URL="https://pharmaboost.app"
PUBLIC_APP_URL="https://pharmaboost.app"
NODE_ENV="production"
APP_ENV="production"
DEMO_MODE="false"

# Sécurité — générer sur le serveur, jamais réutiliser celles du développement
AUTH_SESSION_SECRET=""      # openssl rand -base64 48
DATA_ENCRYPTION_KEY=""      # openssl rand -base64 32

# IA et lecture d'ordonnance (Anthropic)
AI_PROVIDER="anthropic"
OCR_PROVIDER="anthropic"
OCR_SEND_IMAGES_EXTERNALLY="true"
ANTHROPIC_API_KEY=""

# E-mails (Resend) — le domaine pharmaboost.app doit être vérifié chez Resend
EMAIL_PROVIDER="resend"
EMAIL_FROM="contact@pharmaboost.app"
RESEND_API_KEY=""
SMS_PROVIDER="none"

# Fichiers (ordonnances photographiées) : volume Docker local, ou S3
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="/app/storage"

# ---------------------------------------------------------------------------
# Hébergeur HDS (voir docs/HDS.md). Les ordonnances photographiées vivent dans
# la base (STORAGE_PROVIDER=database) : elles migrent avec elle. Pour un
# stockage objet chez l'hébergeur HDS (Cellar chez Clever Cloud, Object
# Storage chez OVHcloud), passer en s3 et renseigner le bucket privé :
# STORAGE_PROVIDER=s3
# S3_BUCKET=…
# S3_REGION=…
# S3_ENDPOINT=…            (ex. https://cellar-c2.services.clever-cloud.com)
# S3_ACCESS_KEY_ID=…
# S3_SECRET_ACCESS_KEY=…

